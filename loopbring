-- Helper function to generate control buttons matching the layout perfectly
local function createSmallButton(text, xPos, yPos)
    local btn = Instance.new("Frame")
    btn.Size = UDim2.new(0, 32, 0, 36)
    btn.Position = UDim2.new(0, xPos, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(15, 22, 32)
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = btn
    
    local btnStroke = Instance.new("UIStroke")
    btnStroke.Thickness = 2.5
    btnStroke.Color = Color3.fromRGB(0, 240, 255)
    btnStroke.Parent = btn
    
    local clicker = Instance.new("TextButton")
    clicker.Size = UDim2.new(1, 0, 1, 0)
    clicker.BackgroundTransparency = 1
    clicker.Text = text
    clicker.TextColor3 = Color3.fromRGB(0, 240, 255)
    clicker.TextSize = 18
    clicker.Font = Enum.Font.GothamBold
    clicker.Parent = btn
    
    btn.Parent = MainPanel
    return clicker
end

