-- Helper function to generate matching small control buttons
local function createSmallButton(text, xPos, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 28, 0, 32)
    btn.Position = UDim2.new(0, xPos, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Pitch black matching style
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 16
    btn.Font = Enum.Font.SourceSansBold
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = btn
    
    -- Matching neon-green stroke outline for side buttons
    local btnStroke = Instance.new("UIStroke")
    btnStroke.Thickness = 1.5
    btnStroke.Color = Color3.fromRGB(0, 255, 120)
    btnStroke.Parent = btn
    
    btn.Parent = MainPanel
    return btn
end

