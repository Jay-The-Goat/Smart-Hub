----------------------------------------------------
-- SYSTEM VARIABLES & CONFIGURATION STATE
----------------------------------------------------
local targetLoopList = {} 
local currentDistance = 5 
local directions = {"Front", "Back", "Left", "Right", "Above"}
local currentDirIndex = 1 

-- Toggle visibility layer for selection dropdown menu
TextButtonTrigger.MouseButton1Click:Connect(function()
    DropdownFrame.Visible = not DropdownFrame.Visible
    if DropdownFrame.Visible then
        -- Clear prior rows
        for _, child in ipairs(DropdownFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        
        -- Map actively joined server lists dynamically
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local pBtn = Instance.new("TextButton")
                pBtn.Size = UDim2.new(1, 0, 0, 25)
                -- Active text glows neon green, inactive sits dark
                pBtn.BackgroundColor3 = targetLoopList[p.Name] and Color3.fromRGB(20, 50, 30) or Color3.fromRGB(15, 15, 15)
                pBtn.Text = p.DisplayName or p.Name
                pBtn.TextColor3 = targetLoopList[p.Name] and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(240, 240, 240)
                pBtn.TextSize = 12
                pBtn.Font = Enum.Font.SourceSans
                pBtn.Parent = DropdownFrame
                
                -- Toggle Target Status Handler on click
                pBtn.MouseButton1Click:Connect(function()
                    if targetLoopList[p.Name] then
                        targetLoopList[p.Name] = nil
                        pBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
                        pBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
                    else
                        targetLoopList[p.Name] = p
                        pBtn.BackgroundColor3 = Color3.fromRGB(20, 50, 30)
                        pBtn.TextColor3 = Color3.fromRGB(0, 255, 120)
                    end
                end)
            end
        end
        DropdownFrame.CanvasSize = UDim2.new(0, 0, 0, DropdownList.AbsoluteContentSize.Y)
    end
end)

----------------------------------------------------
-- OFFSET & POSITION ALIGNMENT CYCLING LOGIC
----------------------------------------------------
local function flashFeedback(button)
    local btnStroke = button:FindFirstChildOfClass("UIStroke")
    if btnStroke then
        local oldColor = btnStroke.Color
        btnStroke.Color = Color3.fromRGB(255, 255, 255) -- Flash border white on tap
        task.wait(0.08)
        btnStroke.Color = oldColor
    end
end

PlusBtn.MouseButton1Click:Connect(function()
    currentDistance = math.clamp(currentDistance + 2, 2, 30)
    flashFeedback(PlusBtn)
end)

MinusBtn.MouseButton1Click:Connect(function()
    currentDistance = math.clamp(currentDistance - 2, 2, 30)
    flashFeedback(MinusBtn)
end)

LeftBtn.MouseButton1Click:Connect(function()
    currentDirIndex = currentDirIndex - 1
    if currentDirIndex < 1 then currentDirIndex = #directions end
    flashFeedback(LeftBtn)
    print("Direction Shifted to: " .. directions[currentDirIndex])
end)

RightBtn.MouseButton1Click:Connect(function()
    currentDirIndex = currentDirIndex + 1
    if currentDirIndex > #directions then currentDirIndex = 1 end
    flashFeedback(RightBtn)
    print("Direction Shifted to: " .. directions[currentDirIndex])
end)

----------------------------------------------------
-- BACKGROUND ENGINE: CONTINUOUS LOOP-BRINGING LOOP
----------------------------------------------------
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if root then
        local selectedDirection = directions[currentDirIndex]
        local positionalOffset = Vector3.new(0, 0, 0)
        
        if selectedDirection == "Front" then
            positionalOffset = root.CFrame.LookVector * currentDistance
        elseif selectedDirection == "Back" then
            positionalOffset = -root.CFrame.LookVector * currentDistance
        elseif selectedDirection == "Left" then
            positionalOffset = -root.CFrame.RightVector * currentDistance
        elseif selectedDirection == "Right" then
            positionalOffset = root.CFrame.RightVector * currentDistance
        elseif selectedDirection == "Above" then
            positionalOffset = Vector3.new(0, currentDistance, 0)
        end
        
        local chosenDestination = root.Position + positionalOffset
        
        for name, p in pairs(targetLoopList) do
            if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local tRoot = p.Character.HumanoidRootPart
                tRoot.Velocity = Vector3.new(0, 0, 0) 
                tRoot.CFrame = CFrame.new(chosenDestination) * (root.CFrame - root.Position)
            end
        end
    end
end)
