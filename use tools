-- ================== TOOL HELPERS ==================
local function getHRP(c)
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"))
end
local function getRightHand(c) return c and (c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")) end
local function getLeftHand(c) return c and (c:FindFirstChild("LeftHand") or c:FindFirstChild("Left Arm")) end

local function getToolTouchPart(tool)
    local h = tool:FindFirstChild("Handle")
    if h and h:IsA("BasePart") then return h end
    for _,obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("TouchTransmitter") and obj.Parent and obj.Parent:IsA("BasePart") then
            return obj.Parent
        end
    end
    return nil
end

local function removeToolWeld(tool)
    local w = state.toolWelds[tool]
    if w and w.Parent then w:Destroy() end
    state.toolWelds[tool] = nil
end

local function applyToolWelds()
    if not state.currentChar or not state.active then return end
    local char = state.currentChar
    local rHand = getRightHand(char)
    local lHand = getLeftHand(char)
    if not rHand or not lHand then return end
    local rTools, lTools = {}, {}
    for _,tool in ipairs(state.toolsCache) do
        local handle = tool and tool:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then
            if tool.Name and tool.Name:lower():find("axe") then
                table.insert(lTools,tool)
            else
                table.insert(rTools,tool)
            end
        end
    end
    for i,tool in ipairs(rTools) do
        local handle = tool:FindFirstChild("Handle")
        if handle then
            removeToolWeld(tool)
            local weld = Instance.new("Motor6D")
            weld.Name = "TFL_ToolWeld"
            weld.Part0 = handle
            weld.Part1 = rHand
            weld.C0 = CFrame.new(-tool.GripPos.X, -tool.GripPos.Y, -tool.GripPos.Z)
            weld.C1 = tool.Grip * CFrame.fromAxisAngle(Vector3.new(0,1,0), (i-1)*0.3)
            weld.Parent = handle
            state.toolWelds[tool] = weld
            if not handle:GetAttribute("TFL_WasCanCollide") then
                handle:SetAttribute("TFL_WasCanCollide", handle.CanCollide)
            end
            handle.CanCollide = false
            handle.Massless = true
        end
    end
    for i,tool in ipairs(lTools) do
        local handle = tool:FindFirstChild("Handle")
        if handle then
            removeToolWeld(tool)
            local weld = Instance.new("Motor6D")
            weld.Name = "TFL_ToolWeld"
            weld.Part0 = handle
            weld.Part1 = lHand
            weld.C0 = CFrame.new(-tool.GripPos.X, -tool.GripPos.Y, -tool.GripPos.Z)
            weld.C1 = tool.Grip
            weld.Parent = handle
            state.toolWelds[tool] = weld
            if not handle:GetAttribute("TFL_WasCanCollide") then
                handle:SetAttribute("TFL_WasCanCollide", handle.CanCollide)
            end
            handle.CanCollide = false
            handle.Massless = true
        end
    end
end

local function removeAllWelds()
    for _,tool in ipairs(state.toolsCache) do
        if tool then
            local handle = tool:FindFirstChild("Handle")
            if handle then
                local wc = handle:GetAttribute("TFL_WasCanCollide")
                if wc ~= nil then handle.CanCollide = wc end
                handle.Massless = false
            end
            removeToolWeld(tool)
        end
    end
    table.clear(state.toolWelds)
end

local function cacheTools()
    table.clear(state.toolsCache)
    local char = state.currentChar
    if not char then return end
    local count = 0
    for _,tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            count = count + 1
            if count <= Config.MaxTools then
                table.insert(state.toolsCache,tool)
            end
        end
    end
end

local function equipAllTools()
    local char = state.currentChar
    if not char then return end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not bp then return end
    local eq = 0
    for _,tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") and eq < Config.MaxTools then
            tool.Parent = char
            eq = eq + 1
        end
    end
end

local function hasBackpackTools()
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not bp then return false end
    for _,c in ipairs(bp:GetChildren()) do
        if c:IsA("Tool") then return true end
    end
    return false
end

local function equipCacheAndWeld()
    if not state.active then return false end
    equipAllTools()
    cacheTools()
    if #state.toolsCache > 0 then
        applyToolWelds()
        return true
    end
    return false
end

local function requestReequip()
    if not state.active then return end
    task.spawn(function()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        state.currentChar = char
        state.currentRoot = getHRP(char) or char:WaitForChild("HumanoidRootPart",5)
        local deadline = os.clock()+3
        repeat
            if not state.active then return end
            if equipCacheAndWeld() and not hasBackpackTools() then return end
            RunService.Heartbeat:Wait()
        until os.clock() >= deadline
        equipCacheAndWeld()
    end)
end

local function getClosestTarget()
    if not state.currentRoot then return nil end
    local closest, bestDist = nil, 14
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            if char then
                local root = getHRP(char)
                local hum = char:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health>0 then
                    local d = (root.Position - state.currentRoot.Position).Magnitude
                    if d < bestDist then
                        bestDist = d
                        closest = char
                    end
                end
            end
        end
    end
    return closest
end

local function touchAssist()
    local target = getClosestTarget()
    if not target then return end
    local parts = {}
    for _,name in ipairs({"HumanoidRootPart","UpperTorso","Torso","Head"}) do
        local p = target:FindFirstChild(name)
        if p and p:IsA("BasePart") then table.insert(parts,p) end
    end
    if #parts==0 then return end
    for _,tool in ipairs(state.toolsCache) do
        if tool and tool.Parent and tool:IsDescendantOf(workspace) then
            local touch = getToolTouchPart(tool)
            if touch then
                for _,p in ipairs(parts) do
                    pcall(firetouchinterest,touch,p,0)
                    pcall(firetouchinterest,touch,p,1)
                end
            end
        end
    end
end

local function activateTools()
    for _,tool in ipairs(state.toolsCache) do
        if tool and tool.Parent and tool:IsDescendantOf(workspace) then
            local fe = tool:FindFirstChild("FightEvent",true)
            if Config.Mode=="Normal" then
                pcall(tool.Activate,tool)
            elseif Config.Mode=="Event" then
                if fe and fe:IsA("RemoteEvent") then pcall(fe.FireServer,fe) end
            else
                pcall(tool.Activate,tool)
                if fe and fe:IsA("RemoteEvent") then pcall(fe.FireServer,fe) end
            end
        end
    end
end

local function damagePulse()
    activateTools()
    touchAssist()
end

-- ================== NO COOLDOWN (ALL MODES) ==================
local function clearCooldownValues(tool)
    local cd = tool:FindFirstChild("Cooldown")
    if cd then if cd:IsA("IntValue") then cd.Value = 0 elseif cd:IsA("NumberValue") then cd.Value = 0 end end
    local cm = tool:FindFirstChild("CooldownMax")
    if cm then if cm:IsA("IntValue") then cm.Value = 0 elseif cm:IsA("NumberValue") then cm.Value = 0 end end
    local ct = tool:FindFirstChild("CooldownTime")
    if ct then if ct:IsA("IntValue") then ct.Value = 0 elseif ct:IsA("NumberValue") then ct.Value = 0 end end
    local nu = tool:FindFirstChild("NextUse")
    if nu and nu:IsA("NumberValue") then nu.Value = 0 end
    local tc = tool:FindFirstChild("ToolCooldown")
    if tc and tc:IsA("NumberValue") then tc.Value = 0 end
    local cl = tool:FindFirstChild("CooldownLeft")
    if cl and cl:IsA("NumberValue") then cl.Value = 0 end
    local st = tool:FindFirstChild("LastUsed")
    if st and st:IsA("StringValue") then st.Value = "0" end
end

local function clearModuleCooldowns(tool)
    if tool:GetAttribute("OnCooldown") ~= nil then tool:SetAttribute("OnCooldown", false) end
    if tool:GetAttribute("Cooldown") ~= nil then tool:SetAttribute("Cooldown", 0) end
    if tool:GetAttribute("NextAttack") ~= nil then tool:SetAttribute("NextAttack", 0) end
    if tool:GetAttribute("LastUse") ~= nil then tool:SetAttribute("LastUse", 0) end
    for _, desc in ipairs(tool:GetDescendants()) do
        if desc:IsA("IntValue") or desc:IsA("NumberValue") then
            local n = desc.Name:lower()
            if n:find("cooldown") or n:find("cooldownmax") or n:find("cooldowntime") or n:find("nextuse") then
                pcall(function() desc.Value = 0 end)
            end
        elseif desc:IsA("BoolValue") and desc.Name:lower():find("cooldown") then
            pcall(function() desc.Value = false end)
        elseif desc:IsA("StringValue") and (desc.Name:lower():find("lastuse") or desc.Name:lower():find("timestamp")) then
            pcall(function() desc.Value = "0" end)
        end
    end
end

local function remoteBypassCooldown(tool)
    local fe = tool:FindFirstChild("FightEvent", true)
    if fe and fe:IsA("RemoteEvent") then
        pcall(fe.FireServer, fe)
    end
    local atk = tool:FindFirstChild("AttackEvent", true)
    if atk and atk:IsA("RemoteEvent") then
        pcall(atk.FireServer, atk)
    end
end

local function cancelAnimations(tool)
    local hum = tool.Parent and tool.Parent:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
            pcall(track.Stop, 0)
        end
    end
    local animCtrl = tool:FindFirstChildOfClass("AnimationController")
    if animCtrl then
        for _, track in ipairs(animCtrl:GetPlayingAnimationTracks()) do
            pcall(track.Stop, 0)
        end
    end
end

local function resetTags(tool)
    for _, tag in ipairs(CollectionService:GetTags(tool)) do
        if tag:lower():find("cooldown") or tag:lower():find("debounce") then
            pcall(CollectionService.RemoveTag, tool, tag)
        end
    end
    tool:SetAttribute("OnCooldown", false)
    tool:SetAttribute("Cooldown", 0)
    tool:SetAttribute("NextAttack", 0)
    tool:SetAttribute("LastUse", 0)
end

local function clearCharacterCooldowns()
    local char = LocalPlayer.Character
    if not char then return end
    local cd = char:FindFirstChild("Cooldown")
    if cd and cd:IsA("IntValue") then cd.Value = 0 end
    local cm = char:FindFirstChild("CooldownMax")
    if cm and cm:IsA("IntValue") then cm.Value = 0 end
    local nu = char:FindFirstChild("NextUse")
    if nu and nu:IsA("NumberValue") then nu.Value = 0 end
    if char:GetAttribute("OnCooldown") ~= nil then char:SetAttribute("OnCooldown", false) end
    if char:GetAttribute("Cooldown") ~= nil then char:SetAttribute("Cooldown", 0) end
end

local function performNoCooldown()
    if not Config.NoCooldown then return end
    clearCharacterCooldowns()
    for _, tool in ipairs(state.toolsCache) do
        if tool and tool.Parent then
            clearCooldownValues(tool)
            clearModuleCooldowns(tool)
            remoteBypassCooldown(tool)
            cancelAnimations(tool)
            resetTags(tool)
        end
    end
end

-- ================== MAIN LOOP ==================
RunService.RenderStepped:Connect(function()
    if not state.active then return end
    if not state.currentChar or not state.currentRoot or #state.toolsCache == 0 then
        requestReequip()
        return
    end
    SlotBadge.Text = tostring(#state.toolsCache)
    damagePulse()
    performNoCooldown()
end)

-- ================== UI INTERACTION ==================
local function updatePanelPosition()
    if ModePanel.Visible then
        ModePanel.Position = UDim2.new(0, ToolFrame.AbsolutePosition.X, 0, ToolFrame.AbsolutePosition.Y + ToolFrame.AbsoluteSize.Y + 4)
    end
end

ToolFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(updatePanelPosition)
ToolFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updatePanelPosition)

InteractionButton.MouseButton1Click:Connect(function()
    state.active = not state.active
    Config.Enabled = state.active

    ModePanel.Visible = state.active
    updatePanelPosition()

    if state.active then
        TweenService:Create(ToolStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(0, 255, 120)}):Play()
        TweenService:Create(StatusDot, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(0, 255, 120)}):Play()
        requestReequip()
    else
        TweenService:Create(ToolStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(255, 50, 50)}):Play()
        TweenService:Create(StatusDot, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 50, 50)}):Play()
        removeAllWelds()
        table.clear(state.toolsCache)
        local character = LocalPlayer.Character
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if character and backpack then
            for _, item in ipairs(character:GetChildren()) do
                if item:IsA("Tool") then
                    item.Parent = backpack
                end
            end
        end
        SlotBadge.Text = "0"
    end
    updateLabel()
end)

function updateLabel()
    if state.active then
        ToolLabel.Text = "UseTools (" .. Config.Mode .. ")"
    else
        ToolLabel.Text = "UseTools"
    end
end

function cycleMode()
    if not state.active then return end
    local idx
    for i, m in ipairs(MODES_ORDER) do
        if m == Config.Mode then idx = i; break end
    end
    idx = idx or 1
    idx = idx % #MODES_ORDER + 1
    Config.Mode = MODES_ORDER[idx]
    updateModeHighlight()
    updateLabel()
    print("[Use Tools] Mode:", Config.Mode)
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.K then
        InteractionButton.MouseButton1Click:Fire()
    elseif input.KeyCode == Enum.KeyCode.M then
        cycleMode()
    elseif input.KeyCode == Enum.KeyCode.X then
        Config.NoCooldown = not Config.NoCooldown
        print("[No Cooldown] " .. (Config.NoCooldown and "ENABLED (all modes)" or "DISABLED"))
    end
end)

