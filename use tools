-- ================== DRAGGING (touch + mouse) ==================
local dragging, dragStart, startPos, touchMoved

InteractionButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        touchMoved = false
        dragStart = input.Position
        startPos = ToolFrame.Position
    end
end)

InteractionButton.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
            touchMoved = true
        end
        ToolFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
        if not touchMoved then
            toggle()
        end
    end
end)

-- ================== HELPERS ==================
local function getRightHand(c)
    return c and (c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm"))
end
local function getLeftHand(c)
    return c and (c:FindFirstChild("LeftHand") or c:FindFirstChild("Left Arm"))
end

-- ================== WELDING ==================
local function clearHandGrips(hand)
    for _, v in ipairs(hand:GetChildren()) do
        if v:IsA("Weld") and (v.Name == "RightGrip" or v.Name == "LeftGrip" or v.Name == "TFL_ToolWeld") then
            v:Destroy()
        end
    end
end

local function removeToolWeld(tool)
    local w = state.toolWelds[tool]
    if w and w.Parent then w:Destroy() end
    state.toolWelds[tool] = nil
end

local function weldTo(tool, hand, offset)
    local handle = tool:FindFirstChild("Handle")
    if not handle or not hand then return end

    removeToolWeld(tool)

    local weld = Instance.new("Weld")
    weld.Name = "TFL_ToolWeld"
    weld.Part0 = hand
    weld.Part1 = handle
    weld.C0 = offset
    weld.C1 = tool.Grip
    weld.Parent = hand

    state.toolWelds[tool] = weld

    if not handle:GetAttribute("TFL_WasCanCollide") then
        handle:SetAttribute("TFL_WasCanCollide", handle.CanCollide)
    end
    handle.CanCollide = false
    handle.Massless = true
end

local function applyToolWelds()
    if not state.currentChar or not state.active then return end
    local char = state.currentChar
    local rHand = getRightHand(char)
    local lHand = getLeftHand(char)
    if not rHand or not lHand then return end

    clearHandGrips(rHand)
    clearHandGrips(lHand)

    local rTools, lTools = {}, {}
    for _, tool in ipairs(state.toolsCache) do
        local handle = tool and tool:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then
            if tool.Name and tool.Name:lower():find("axe") then
                table.insert(lTools, tool)
            else
                table.insert(rTools, tool)
            end
        end
    end

    for i, tool in ipairs(rTools) do
        weldTo(tool, rHand, CFrame.new(0, 0, 0) * CFrame.Angles(0, (i - 1) * 0.3, 0))
    end
    for i, tool in ipairs(lTools) do
        weldTo(tool, lHand, CFrame.new(0, 0, 0))
    end
end

local function removeAllWelds()
    local char = state.currentChar
    if char then
        local rHand = getRightHand(char)
        local lHand = getLeftHand(char)
        if rHand then clearHandGrips(rHand) end
        if lHand then clearHandGrips(lHand) end
    end
    for _, tool in ipairs(state.toolsCache) do
        if tool then
            local handle = tool:FindFirstChild("Handle")
            if handle then
                local wc = handle:GetAttribute("TFL_WasCanCollide")
                if wc ~= nil then handle.CanCollide = wc end
                handle.Massless = false
            end
            removeToolWeld(tool)
        end
    end
    table.clear(state.toolWelds)
end

-- ================== EQUIP / CACHE ==================
local function cacheTools()
    table.clear(state.toolsCache)
    local char = state.currentChar
    if not char then return end
    local count = 0
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            count = count + 1
            if count <= Config.MaxTools then
                table.insert(state.toolsCache, tool)
            end
        end
    end
end

local function equipAllTools()
    local char = state.currentChar
    if not char then return end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not bp then return end
    local eq = 0
    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") and eq < Config.MaxTools then
            tool.Parent = char
            eq = eq + 1
        end
    end
end

local function hasBackpackTools()
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not bp then return false end
    for _, c in ipairs(bp:GetChildren()) do
        if c:IsA("Tool") then return true end
    end
    return false
end

local function equipCacheAndWeld()
    if not state.active then return false end
    equipAllTools()
    cacheTools()
    if #state.toolsCache > 0 then
        applyToolWelds()
        return true
    end
    return false
end

local function requestReequip()
    if not state.active then return end
    task.spawn(function()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        state.currentChar = char
        local deadline = os.clock() + 3
        repeat
            if not state.active then return end
            if equipCacheAndWeld() and not hasBackpackTools() then return end
            RunService.Heartbeat:Wait()
        until os.clock() >= deadline
        equipCacheAndWeld()
    end)
end

-- ================== ACTIVATION ==================
local function activateTools()
    for _, tool in ipairs(state.toolsCache) do
        if tool and tool.Parent and tool:IsDescendantOf(workspace) then
            pcall(tool.Activate, tool)
        end
    end
end

-- ================== TOGGLE ==================
local function stopAll()
    removeAllWelds()
    table.clear(state.toolsCache)
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if character and backpack then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
                item.Parent = backpack
            end
        end
    end
    SlotBadge.Text = "0"
end

function toggle()
    state.active = not state.active

    if state.active then
        ToolLabel.Text = "UseTools ON"
        TweenService:Create(ToolStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(0, 255, 120)}):Play()
        TweenService:Create(StatusDot, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(0, 255, 120)}):Play()
        print("[Use Tools] ENABLED")
        requestReequip()
    else
        ToolLabel.Text = "UseTools"
        TweenService:Create(ToolStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(255, 50, 50)}):Play()
        TweenService:Create(StatusDot, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 50, 50)}):Play()
        print("[Use Tools] DISABLED")
        stopAll()
    end
end

-- ================== MAIN LOOP ==================
RunService.RenderStepped:Connect(function()
    if not state.active then return end
    if not state.currentChar or #state.toolsCache == 0 then
        requestReequip()
        return
    end
    SlotBadge.Text = tostring(#state.toolsCache)
    activateTools()
end)

-- ================== KEYBOARD FALLBACK ==================
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.K then
        toggle()
    end
end)

-- ================== CHARACTER HANDLING ==================
LocalPlayer.CharacterAdded:Connect(function(char)
    if state.active then
        state.currentChar = char
        requestReequip()
    end
end)

if LocalPlayer.Character then
    state.currentChar = LocalPlayer.Character
end

print("[Use Tools] Mobile compact bar loaded. Tap the bar to toggle, drag to move.")