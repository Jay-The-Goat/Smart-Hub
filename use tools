-- Structural Logic Configuration States
local active = false
local menuOpen = false
local selectedToolName = "All"
local loopConn

local function unequipAllTools()
	local char = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	
	if char and backpack then
		for _, tool in ipairs(char:GetChildren()) do
			if tool:IsA("Tool") then
				tool.Parent = backpack
			end
		end
	end
end

-- ULTRA-SPEED LIGHTNING EQUIPMENT HOOK
local function equipAndActivate()
	if not active then return end
	
	local char = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not char or not backpack then return end

	if selectedToolName == "All" then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") then
				tool.Parent = char
			end
		end

		for _, tool in ipairs(char:GetChildren()) do
			if tool:IsA("Tool") then
				task.spawn(pcall, tool.Activate, tool)
			end
		end
	else
		for _, tool in ipairs(char:GetChildren()) do
			if tool:IsA("Tool") and tool.Name ~= selectedToolName then
				tool.Parent = backpack
			end
		end

		local targetTool = backpack:FindFirstChild(selectedToolName) or char:FindFirstChild(selectedToolName)
		if targetTool then
			if targetTool.Parent ~= char then
				targetTool.Parent = char
			end
			task.spawn(pcall, targetTool.Activate, targetTool)
		end
	end
end

local function refreshDropdownList()
	for _, child in ipairs(ScrollFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local toolsFound = {"All Tools"}

	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") and not table.find(toolsFound, tool.Name) then
				table.insert(toolsFound, tool.Name)
			end
		end
	end

	local char = player.Character
	if char then
		for _, tool in ipairs(char:GetChildren()) do
			if tool:IsA("Tool") and not table.find(toolsFound, tool.Name) then
				table.insert(toolsFound, tool.Name)
			end
		end
	end

	for _, name in ipairs(toolsFound) do
		local isSelected = (name == "All Tools" and selectedToolName == "All") or (name == selectedToolName)

		local btn = Instance.new("TextButton")
		btn.Name = name
		btn.Size = UDim2.new(1, -2, 0, 28) 
		btn.BackgroundColor3 = isSelected and Color3.fromRGB(32, 16, 48) or ContentCardBg
		btn.BackgroundTransparency = 0.15
		btn.Text = (isSelected and "★ " or "") .. name
		btn.TextColor3 = isSelected and ActiveGreen or PassiveTextColor
		btn.Font = Enum.Font.GothamMedium
		btn.TextSize = 11
		btn.AutoButtonColor = false
		btn.Parent = ScrollFrame

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 5)
		btnCorner.Parent = btn

		local btnStroke = Instance.new("UIStroke")
		btnStroke.Thickness = 1
		btnStroke.Color = isSelected and NeonPurpleGlow or Color3.fromRGB(45, 52, 72)
		btnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		btnStroke.Parent = btn

		btn.MouseEnter:Connect(function()
			if not isSelected then
				TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(24, 28, 40)}):Play()
				TweenService:Create(btnStroke, TweenInfo.new(0.1), {Color = NeonCyanAccent}):Play()
			end
		end)

		btn.MouseLeave:Connect(function()
			if not isSelected then
				TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = ContentCardBg}):Play()
				TweenService:Create(btnStroke, TweenInfo.new(0.1), {Color = Color3.fromRGB(45, 52, 72)}):Play()
			end
		end)

		btn.MouseButton1Click:Connect(function()
			if name == "All Tools" then
				selectedToolName = "All"
			else
				selectedToolName = name
				unequipAllTools()
			end
			refreshDropdownList()
		end)
	end
end

local function toggleDropdown()
	menuOpen = not menuOpen

	if menuOpen then
		refreshDropdownList()
		DropdownFrame.Visible = true
		DropdownFrame.Size = UDim2.new(1, 0, 0, 0)

		local buttonCount = #ScrollFrame:GetChildren() - 1
		local calculatedHeight = math.clamp(buttonCount * 33 + 12, 45, 150)

		DropdownArrowBtn.Text = "▲"

		local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		TweenService:Create(DropdownFrame, tweenInfo, {
			Size = UDim2.new(1, 0, 0, calculatedHeight)
		}):Play()
	else
		DropdownArrowBtn.Text = "▼"
		local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		local tween = TweenService:Create(DropdownFrame, tweenInfo, {
			Size = UDim2.new(1, 0, 0, 0)
		})
		tween:Play()
		tween.Completed:Connect(function()
			if not menuOpen then
				DropdownFrame.Visible = false
			end
		end)
	end
end

DropdownArrowBtn.MouseButton1Click:Connect(toggleDropdown)
