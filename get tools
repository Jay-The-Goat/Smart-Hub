---------------------------------------------------

local function tapPad(root, pad, baseName, burstCount)
	if type(firetouchinterest) ~= "function" then
		if not warnedMissingTouch then
			warn("[Smart Hub Tool Grabber] firetouchinterest indisponivel.")
			warnedMissingTouch = true
		end
		return
	end

	-- Multi-threaded instantaneous firing sequence
	for i = 1, burstCount do
		task.spawn(function()
			firetouchinterest(root, pad, 0)
			firetouchinterest(root, pad, 1)
		end)
	end
end

local function acquireToolsSequence(currentSerial)
	local root = getRoot()
	if not root then return end

	local now = os.clock()
	local forceAll = (now < forceAllUntil)

	for _, rule in ipairs(TOOL_RULES) do
		if not alive or currentSerial ~= scheduleSerial then return end

		local baseName = rule.Base
		local forced = rule.ForceBase or forceAll or (baseForceUntil[baseName] and now < baseForceUntil[baseName])

		if forced or not hasTool(rule.Pattern) then
			local pad = getClosestPad(baseName)
			if pad then
				local burst = (now - forceAllUntil < INSTANT_RESPAWN_WINDOW) and SPAWN_TOUCH_BURST or TOUCH_BURST
				tapPad(root, pad, baseName, burst)
				
				if FORCED_BASE_TOUCHES[baseName] then
					baseTouchCounts[baseName] = (baseTouchCounts[baseName] or 0) + 1
					if baseTouchCounts[baseName] >= FORCED_BASE_TOUCHES[baseName] then
						baseForceUntil[baseName] = 0
					end
				end
			end
		end
	end
end

local function triggerAcquire()
	if acquireRunning then
		acquireQueued = true
		return
	end

	acquireRunning = true
	scheduleSerial = scheduleSerial + 1
	local currentSerial = scheduleSerial

	task.spawn(function()
		while alive and currentSerial == scheduleSerial do
			acquireToolsSequence(currentSerial)
			acquireQueued = false
task.wait(QUICK_RECHECK_DELAY)
if not acquireQueued then
break
end
end
acquireRunning = false
end)
end

