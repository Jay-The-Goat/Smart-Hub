----------------------------------------------------
-- ADVANCED NETWORK HOOKING (6X DUPLICATOR ENGINE)
----------------------------------------------------
local damageScriptActive = false

-- Use Delta's metatable hooking capability to intercept outbound server traffic
local rawMetatable = getrawmetatable(game)
local oldNamecall = rawMetatable.__namecall
setreadonly(rawMetatable, false)

rawMetatable.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    -- If the script is turned on, look for network triggers sent by tools or weapon swings
    if damageScriptActive and (method == "FireServer" or method == "InvokeServer") then
        local remoteName = string.lower(self.Name)
        
        -- Filter for common combat, hitting, punching, or slashing networks
        if string.find(remoteName, "hit") or 
           string.find(remoteName, "damage") or 
           string.find(remoteName, "swing") or 
           string.find(remoteName, "attack") or 
           string.find(remoteName, "punch") or 
           string.find(remoteName, "weapon") or
           string.find(remoteName, "combat") then
            
            -- Intercepted valid combat network packet. Firing 5 extra times for 6X Total Damage.
            task.spawn(function()
                for i = 1, 5 do
                    task.wait(0.01) -- Small delay spacing to safely pass structure anti-cheats
                    if method == "FireServer" then
                        self:FireServer(unpack(args))
                    elseif method == "InvokeServer" then
                        self:InvokeServer(unpack(args))
                    end
                end
            end)
        end
    end
    
    return oldNamecall(self, ...)
end)

setreadonly(rawMetatable, true)

----------------------------------------------------
-- INTERACTION SWITCH CONNECTIONS
----------------------------------------------------
InteractionButton.MouseButton1Click:Connect(function()
    damageScriptActive = not damageScriptActive
    
    if damageScriptActive then
        -- ACTIVE STATE: Text changes to bright neon green
        DamageText.Text = "6X DAMAGE ON"
        DamageText.TextColor3 = Color3.fromRGB(0, 255, 120)
        TweenService:Create(FrameStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(0, 255, 120)}):Play()
        print("Delta Combat Duplicator: Actively multiplying combat packets by 6X.")
    else
        -- DISABLED STATE: Returns to muted gray outline
        DamageText.Text = "6X DAMAGE OFF"
        DamageText.TextColor3 = Color3.fromRGB(255, 50, 50)
        TweenService:Create(FrameStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(80, 80, 80)}):Play()
        print("Delta Combat Duplicator: Disabled.")
    end
end)
