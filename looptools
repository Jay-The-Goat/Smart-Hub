-- MOBILE + PC DUAL-INPUT DRAG TRANSLATION ENGINE
local dragging, dragInput, dragStart, startPos
local btnStartPos
frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
		btnStartPos = toggleBtn.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)
frame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		toggleBtn.Position = UDim2.new(btnStartPos.X.Scale, btnStartPos.X.Offset + delta.X, btnStartPos.Y.Scale, btnStartPos.Y.Offset + delta.Y)
	end
end)

---------------------------------------------------------
-- INTERFACE CORE LIST SYNCING
---------------------------------------------------------
local function refreshList()
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local isTargeted = table.find(bringTargets, p.Name)
			local btn = Instance.new("TextButton")
			btn.Parent = scroll
			btn.Size = UDim2.new(1, -5, 0, 32)
			btn.Text = "  " .. p.DisplayName .. " (@" .. p.Name .. ")"
			btn.Font = Enum.Font.Gotham
			btn.TextSize = 11
			btn.TextXAlignment = Enum.TextXAlignment.Left
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
			
			if isTargeted then
				btn.BackgroundColor3 = Color3.fromRGB(45, 12, 12)
				btn.TextColor3 = Color3.fromRGB(255, 60, 60)
				local bStroke = Instance.new("UIStroke", btn)
				bStroke.Color = Color3.fromRGB(220, 40, 40)
				bStroke.Thickness = 1
			else
				btn.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
				btn.TextColor3 = Color3.fromRGB(170, 170, 180)
			end
			
			btn.MouseEnter:Connect(function()
				TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(28, 24, 30)}):Play()
			end)
			btn.MouseLeave:Connect(function()
				TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = isTargeted and Color3.fromRGB(45, 12, 12) or Color3.fromRGB(18, 18, 22)}):Play()
			end)
			
			btn.MouseButton1Click:Connect(function()
				local idx = table.find(bringTargets, p.Name)
				if idx then
					table.remove(bringTargets, idx)
					if #bringTargets == 0 then stopHeartbeat() end
				else
					table.insert(bringTargets, p.Name)
					startFollowing()
				end
				refreshList()
			end)
		end
	end
	scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
end

