local function refreshList()
	for _, child in ipairs(ScrollFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local isTargeted = table.find(bringTargets, p.Name)
			local btn = Instance.new("TextButton")
			btn.Name = p.Name
			btn.Size = UDim2.new(1, -2, 0, 28) 
			btn.BackgroundColor3 = isTargeted and Color3.fromRGB(48, 16, 26) or ContentCardBg
			btn.BackgroundTransparency = 0.15
			btn.Text = (isTargeted and "☠ " or "") .. p.DisplayName
			btn.TextColor3 = isTargeted and TargetRed or PassiveTextColor
			btn.Font = Enum.Font.GothamMedium
			btn.TextSize = 11
			btn.AutoButtonColor = false
			btn.Parent = ScrollFrame
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

			local btnStroke = Instance.new("UIStroke")
			btnStroke.Thickness = 1
			btnStroke.Color = isTargeted and TargetRed or Color3.fromRGB(45, 52, 72)
			btnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			btnStroke.Parent = btn

			btn.MouseEnter:Connect(function()
				if not isTargeted then
					TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(24, 28, 40)}):Play()
					TweenService:Create(btnStroke, TweenInfo.new(0.1), {Color = NeonCyanAccent}):Play()
				end
			end)
			btn.MouseLeave:Connect(function()
if not isTargeted then
TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = ContentCardBg}):Play()
TweenService:Create(btnStroke, TweenInfo.new(0.1), {Color = Color3.fromRGB(45, 52, 72)}):Play()
end
end)
btn.MouseButton1Click:Connect(function()
local idx = table.find(bringTargets, p.Name)
if idx then
table.remove(bringTargets, idx)
if #bringTargets == 0 then stopHeartbeat() end
else
table.insert(bringTargets, p.Name)
startFollowing()
end
refreshList()
end)
end
end
ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, UIList.AbsoluteContentSize.Y + 4)
end
local menuOpen = false
local function toggleDropdown()
menuOpen = not menuOpen
if menuOpen then
refreshList()
DropdownFrame.Visible = true
DropdownFrame.Size = UDim2.new(1, 0, 0, 0)
local buttonCount = #ScrollFrame:GetChildren() - 1
local calculatedHeight = math.clamp(buttonCount * 33 + 12, 45, 150)
DropdownArrowBtn.Text = "▲"
TweenService:Create(DropdownFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
Size = UDim2.new(1, 0, 0, calculatedHeight)
}):Play()
else
DropdownArrowBtn.Text = "▼"
local tween = TweenService:Create(DropdownFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
Size = UDim2.new(1, 0, 0, 0)
})
tween:Play()
tween.Completed:Connect(function()
if not menuOpen then DropdownFrame.Visible = false end
end)
end
end
DropdownArrowBtn.MouseButton1Click:Connect(toggleDropdown)
ToggleBtn.MouseButton1Click:Connect(toggleDropdown)
-- REPLICATION LIFECYCLE MANAGEMENT
local function onCharacterCreated(char)
char:WaitForChild("HumanoidRootPart")
task.spawn(updateToolCache)
char.ChildAdded:Connect(function(child)
if child:IsA("Tool") then
task.wait()
updateToolCache()
local part = getToolPart(child)
optimizePartPhysics(part)
end
end)
fixToolPhysics()
if #bringTargets > 0 then
startFollowing()
end
end
LocalPlayer.CharacterAdded:Connect(onCharacterCreated)
if LocalPlayer.Character then task.spawn(onCharacterCreated, LocalPlayer.Character) end
Players.PlayerAdded:Connect(refreshList)
Players.PlayerRemoving:Connect(refreshList)
task.spawn(updateToolCache)
task.spawn(fixToolPhysics)
refreshList()