local function getToolPart(tool)
	if tool:FindFirstChild("Handle") and tool.Handle:IsA("BasePart") then return tool.Handle end
	if tool.PrimaryPart and tool.PrimaryPart:IsA("BasePart") then return tool.PrimaryPart end
	local fastCheck = tool:FindFirstChildWhichIsA("BasePart", true)
	if fastCheck then return fastCheck end
	for _, v in ipairs(tool:GetDescendants()) do
		if v:IsA("BasePart") then return v end
	end
	return nil
end

local function updateToolCache()
	table.clear(cachedToolParts)
	local character = LocalPlayer.Character
	if not character then return end
	for _, tool in ipairs(character:GetChildren()) do
		if tool:IsA("Tool") then
			local part = getToolPart(tool)
			if part then cachedToolParts[#cachedToolParts + 1] = part end
		end
	end
end

local function getCachedTargetData(char)
	if cachedTorsos[char] and cachedTorsos[char].Parent then return cachedTorsos[char], cachedVelocities[char] end
	local torso = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if torso then
		cachedTorsos[char] = torso
		cachedVelocities[char] = torso
		return torso, torso
	end
	return nil, nil
end

local function optimizePartPhysics(part)
	if not part or not part.Parent then return end
	part.CanCollide = false
	part.Massless = true
	part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
end

local function fixToolPhysics()
	if not LocalPlayer.Character then return end
	for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
		if tool:IsA("Tool") then
			local part = getToolPart(tool)
			optimizePartPhysics(part)
		end
	end
end

local function stopHeartbeat()
	if heartbeatConnection then
		heartbeatConnection:Disconnect()
		heartbeatConnection = nil
	end
end

local function processToolBringVectors(targetChar)
	local targetRoot, velocityPart = getCachedTargetData(targetChar)
	if not targetRoot or #cachedToolParts == 0 then return end
	local targetVelocity = velocityPart.AssemblyLinearVelocity
	local predictedPosition = targetRoot.Position + (targetVelocity * _G.PredictionWeight)
	local finalPosition = predictedPosition + _G.FollowOffset + _G.AvoidCollisionOffset
	for i = 1, #cachedToolParts do
		local part = cachedToolParts[i]
		if part and part.Parent then
			part.Position = finalPosition
			part.AssemblyLinearVelocity = targetVelocity * 1.5
			firetouchinterest(part, targetRoot, 0)
			firetouchinterest(part, targetRoot, 1)
		end
	end
end

local function startFollowing()
	if heartbeatConnection then return end
	heartbeatConnection = RunService.PostSimulation:Connect(function()
		if #bringTargets == 0 then stopHeartbeat() return end
		if not LocalPlayer.Character then return end
		for i = 1, #bringTargets do
			local plr = Players:FindFirstChild(bringTargets[i])
			if plr and plr.Character then processToolBringVectors(plr.Character) end
		end
	end)
end

