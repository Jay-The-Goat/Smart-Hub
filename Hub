    nav.TextSize = 12
    nav.AutoButtonColor = false
    nav.BackgroundColor3 = (i == 1) and Color3.fromRGB(32, 16, 48) or BTN_DARK
    nav.TextColor3 = (i == 1) and NEON_PURPLE or TEXT_DIM
    nav.Parent = tabBar
    corner(nav, 8)
    tabStrokes[i] = stroke(nav, (i == 1) and NEON_PURPLE or Color3.fromRGB(45, 52, 72), 1.5)
    tabButtons[i] = nav

    nav.MouseButton1Click:Connect(function()
        flashStroke(nav)
        for p = 1, TAB_COUNT do
            local active = (p == i)
            pages[p].Visible               = active
            tabButtons[p].BackgroundColor3 = active and Color3.fromRGB(32, 16, 48) or BTN_DARK
            tabButtons[p].TextColor3       = active and NEON_PURPLE or TEXT_DIM
            tabStrokes[p].Color            = active and NEON_PURPLE or Color3.fromRGB(45, 52, 72)
        end
    end)
end

-- ============================================================
--  Public API (Neon Hub) + AUTO-BIND TO customActions
-- ============================================================
local Hub = {}

function Hub.setAction(tab, index, fn)
    if not actionRegistry[tab] then return end
    if type(fn) ~= "function" then return end
    actionRegistry[tab][index] = fn
end

function Hub.setLabel(tab, index, text)
    local page = pages[tab]
    if not page then return end
    local btn = page:FindFirstChild(string.format("Tab%d_Btn%d", tab, index))
    if btn then
        btn.Text = tostring(text)
    end
end

function Hub.toggle(visible)
    if visible == nil then
        visible = not panel.Visible
    end
    panel.Visible = visible
    if visible then
        panel.Size = UDim2.new(0, 0, 0, 0)
        TweenService:Create(panel,
            TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            { Size = UDim2.new(0, PANEL_W, 0, PANEL_H) }
        ):Play()
    end
end

openBtn.MouseButton1Click:Connect(function()
    flashStroke(openBtn)
    Hub.toggle()
end)

-- ============================================================
--  AUTO-BIND OLD customActions INTO NEON HUB
-- ============================================================
local tabKeyByIndex = {
    [1] = "Tab1",
    [2] = "Tab2",
    [3] = "Tab3",
}

for tabIndex = 1, TAB_COUNT do
    local key = tabKeyByIndex[tabIndex]
    local cfg = customActions[key]
    if cfg then
        for btnIndex = 1, BTNS_PER_TAB do
            local item = cfg[btnIndex]
            if item then
                if item.name then
                    Hub.setLabel(tabIndex, btnIndex, item.name)
                end
                if item.run then
                    Hub.setAction(tabIndex, btnIndex, item.run)
                end
            end
        end
    end
end

return Hub
