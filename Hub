    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 4)
    pad.PaddingLeft = UDim.new(0, 4)
    pad.Parent = page

    pages[i] = page
    actionRegistry[i] = {}

    for b = 1, BTNS_PER_TAB do
        local btn = Instance.new("TextButton")
        btn.Name = string.format("Tab%d_Btn%d", i, b)
        btn.Text = "Button " .. b
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        btn.TextColor3 = NEON_CYAN
        btn.BackgroundColor3 = BTN_DARK
        btn.AutoButtonColor = false
        btn.TextTruncate = Enum.TextTruncate.AtEnd
        btn.LayoutOrder = b
        btn.Parent = page
        corner(btn, 10)
        local bs = stroke(btn, NEON_CYAN, 2)

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = BTN_HOVER }):Play()
            TweenService:Create(bs, TweenInfo.new(0.12), { Thickness = 2.8 }):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = BTN_DARK }):Play()
            TweenService:Create(bs, TweenInfo.new(0.12), { Thickness = 2 }):Play()
        end)

        btn.MouseButton1Click:Connect(function()
            flashStroke(btn)
            local fn = actionRegistry[i][b]
            if fn then
                run_secure(fn)
            end
        end)
    end

    local nav = Instance.new("TextButton")
    nav.Size = UDim2.new(1 / TAB_COUNT, -8, 1, -8)
    nav.Position = UDim2.new((i - 1) * (1 / TAB_COUNT), 4, 0, 4)
