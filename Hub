	navBtn.Parent = tabBar
	Instance.new("UICorner", navBtn).CornerRadius = UDim.new(0, 8)
	tabButtons[i] = navBtn

	navBtn.MouseButton1Click:Connect(function()
		for p = 1, 3 do
			activePages[p].Visible = (p == i)
			tabButtons[p].BackgroundColor3 = (p == i) and Color3.fromRGB(160, 10, 10) or Color3.fromRGB(35, 35, 38)
