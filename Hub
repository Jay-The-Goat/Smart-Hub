-- Generate Pages and Navigation Tabs Dynamically
local activePages = {}
local tabButtons = {}
for i = 1, 3 do
	local pageId = "Tab" .. i
	-- Create the scrolling layout container
	local page = Instance.new("ScrollingFrame")
	page.Name = pageId .. "_Page"
	page.Size = UDim2.new(1, 0, 1, -40)
	page.Position = UDim2.new(0, 0, 0, 40)
	page.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	page.CanvasSize = UDim2.new(0, 0, 4, 0)
	page.ScrollBarThickness = 6
	page.BorderSizePixel = 0
	page.Visible = (i == 1)
	page.Parent = panel
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0, 120, 0, 35)
	grid.CellPadding = UDim2.new(0, 15, 0, 15)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = page
	activePages[i] = page
	-- Generate the 30 action items inside this page container
	for btnIndex = 1, 30 do
		local btn = Instance.new("TextButton")
		btn.Font = Enum.Font.SourceSansBold
		btn.TextSize = 14
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.BackgroundColor3 = Color3.fromRGB(45, 45, 48)
		btn.Parent = page
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
		-- Safely pulls configuration from the master table above
		local itemConfig = customActions[pageId][btnIndex]
		btn.Name = "Action_" .. (itemConfig.name or btnIndex)
		btn.Text = itemConfig.name or ("Item " .. btnIndex)
		btn.MouseButton1Click:Connect(function()
			run_secure(itemConfig.run)
		end)
	end
	-- Create Top Navigation Header Items
	local navBtn = Instance.new("TextButton")
	navBtn.Size = UDim2.new(1/3, 0, 1, 0)
	navBtn.Position = UDim2.new((i - 1) * (1/3), 0, 0, 0)
	navBtn.Text = "TAB " .. i
	navBtn.Font = Enum.Font.SourceSansBold
	navBtn.TextSize = 14
	navBtn.BackgroundColor3 = (i == 1) and Color3.fromRGB(160, 10, 10) or Color3.fromRGB(35, 35, 38)
	navBtn.TextColor3 = (i == 1) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
	navBtn.Parent = tabBar
	Instance.new("UICorner", navBtn).CornerRadius = UDim.new(0, 8)
	tabButtons[i] = navBtn
	-- Setup switching behavior
	navBtn.MouseButton1Click:Connect(function()
		for p = 1, 3 do
			activePages[p].Visible = (p == i)
			tabButtons[p].BackgroundColor3 = (p == i) and Color3.fromRGB(160, 10, 10) or Color3.fromRGB(35, 35, 38)
			tabButtons[p].TextColor3 = (p == i) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
		end
	end)
end

