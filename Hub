	AvatarImage.Position = UDim2.new(0, 10, 0.5, -25)
	AvatarImage.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
	AvatarImage.BorderSizePixel = 0
	AvatarImage.Parent = HealthContainer
	Instance.new("UICorner", AvatarImage).CornerRadius = UDim.new(1, 0)  -- circular

	local HealthLabel = Instance.new("TextLabel")
	HealthLabel.Name = "HealthLabel"
	HealthLabel.Size = UDim2.new(1, -70, 0, 20)
	HealthLabel.Position = UDim2.new(0, 70, 0, 10)
	HealthLabel.BackgroundTransparency = 1
	HealthLabel.Font = Enum.Font.GothamBold
	HealthLabel.TextSize = 13
	HealthLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	HealthLabel.TextXAlignment = Enum.TextXAlignment.Left
	HealthLabel.Parent = HealthContainer

	local GreenBarTrack = Instance.new("Frame")
	GreenBarTrack.Name = "GreenBarTrack"
	GreenBarTrack.Size = UDim2.new(1, -70, 0, 14)
	GreenBarTrack.Position = UDim2.new(0, 70, 0, 34)
	GreenBarTrack.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	GreenBarTrack.BorderSizePixel = 0
	GreenBarTrack.Parent = HealthContainer
	Instance.new("UICorner", GreenBarTrack).CornerRadius = UDim.new(0, 7)

	local GreenBar = Instance.new("Frame")
	GreenBar.Name = "GreenBar"
	GreenBar.Size = UDim2.new(1, 0, 1, 0)
	GreenBar.BackgroundColor3 = Color3.fromRGB(80, 220, 80)
	GreenBar.BorderSizePixel = 0
	GreenBar.Parent = GreenBarTrack
	Instance.new("UICorner", GreenBar).CornerRadius = UDim.new(0, 7)

	local NameLabel = Instance.new("TextLabel")
	NameLabel.Name = "NameLabel"
	NameLabel.Size = UDim2.new(1, -70, 0, 18)
	NameLabel.Position = UDim2.new(0, 70, 0, 52)
	NameLabel.BackgroundTransparency = 1
	NameLabel.Font = Enum.Font.SourceSans
	NameLabel.TextSize = 11
	NameLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
	NameLabel.TextXAlignment = Enum.TextXAlignment.Left
	NameLabel.Text = localPlayer.DisplayName .. " (@" .. localPlayer.Name .. ")"
	NameLabel.Parent = HealthContainer

	local function updateNameLabel()
		NameLabel.Text = localPlayer.DisplayName .. " (@" .. localPlayer.Name .. ")"
	end
	localPlayer:GetPropertyChangedSignal("DisplayName"):Connect(updateNameLabel)
	localPlayer:GetPropertyChangedSignal("Name"):Connect(updateNameLabel)

	local function setAvatarHeadshot()
		task.spawn(function()
			local userId = localPlayer.UserId
			local thumbType = Enum.ThumbnailType.HeadShot
			local thumbSize = Enum.ThumbnailSize.Size150x150
			local success, content = pcall(function()
				return Players:GetUserThumbnailAsync(userId, thumbType, thumbSize)
			end)
			if success and content then
				AvatarImage.Image = content
			end
		end)
	end

	local function applyUIHealthUpdate(humanoid)
		if not humanoid then return end
		local maxHealth = humanoid.MaxHealth
		if maxHealth <= 0 then return end
		local currentHealth = math.clamp(humanoid.Health, 0, maxHealth)
		HealthLabel.Text = string.format("HEALTH      %d / %d", math.floor(currentHealth), math.floor(maxHealth))
		local healthRatio = currentHealth / maxHealth
		GreenBar:TweenSize(UDim2.new(healthRatio, 0, 1, 0), "Out", "Quad", 0.2, true)
	end

	local function connectHumanoidMetrics(character)
		if not character then return end
		local humanoid = character:WaitForChild("Humanoid", 10)
		if humanoid then
			humanoid.HealthChanged:Connect(function()
				applyUIHealthUpdate(humanoid)
			end)
			humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
				applyUIHealthUpdate(humanoid)
			end)
			applyUIHealthUpdate(humanoid)
		end
	end

	setAvatarHeadshot()
	if localPlayer.Character then
		connectHumanoidMetrics(localPlayer.Character)
	end
	localPlayer.CharacterAdded:Connect(connectHumanoidMetrics)
end)
