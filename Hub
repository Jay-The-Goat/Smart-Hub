local function applyHealth(humanoid)
    if not humanoid or humanoid.MaxHealth <= 0 then return end
    local cur = math.clamp(humanoid.Health, 0, humanoid.MaxHealth)
    healthLabel.Text = string.format("HEALTH  %d / %d", math.floor(cur), math.floor(humanoid.MaxHealth))
    local ratio = cur / humanoid.MaxHealth
    TweenService:Create(healthFill,
        TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = UDim2.new(ratio, 0, 1, 0) }
    ):Play()
end

local function bindCharacter(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end
    hum.HealthChanged:Connect(function() applyHealth(hum) end)
    hum:GetPropertyChangedSignal("MaxHealth"):Connect(function() applyHealth(hum) end)
    applyHealth(hum)
end
if player.Character then bindCharacter(player.Character) end
player.CharacterAdded:Connect(bindCharacter)

local fpsTracker = 60
RunService.RenderStepped:Connect(function(dt)
    fpsTracker = math.floor(1 / dt)
end)

local pingAccum = 0
RunService.Heartbeat:Connect(function(dt)
    pingAccum += dt
    if pingAccum < 0.5 then return end
    pingAccum = 0

    local ok, ping = pcall(function()
        return math.floor(player:GetNetworkPing() * 1000)
    end)
    pingLabel.Text = string.format("PING: %sms", ok and ping or "--")
    fpsLabel.Text  = string.format("FPS: %d", fpsTracker)
end)

