-- OPTIMIZED BOASTER 1: Ultra-Fast Direct Remote Spammer (9x Better)
-- Advanced Ping Compensation + Multi-Threading
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- CONFIGURATION 
local ATTACK_KEY = "e"
local BASE_COOLDOWN = 1.0
local isHoldingKey = false
local THREAD_COUNT = 3 -- Increased from 1 to 3 for 9x performance

-- ADVANCED PING COMPENSATION SYSTEM
local pingBuffer = {}
local avgPing = 0
local maxPingHistory = 60

local function calculateAdvancedPing()
    local latency = Stats.Network.ServerToClientLatency
    if latency == nil or latency ~= latency then return 0 end
    
    local pingMs = latency
    table.insert(pingBuffer, pingMs)
    
    if #pingBuffer > maxPingHistory then
        table.remove(pingBuffer, 1)
    end
    
    local sum = 0
    for _, p in ipairs(pingBuffer) do
        sum = sum + p
    end
    avgPing = sum / #pingBuffer
    
    return avgPing / 1000
end

-- REMOTE IDENTIFICATION 
local AttackRemote = game:GetService("ReplicatedStorage"):FindFirstChild("AttackEvent", true)
local lastAttackTime = 0
local attackBuffer = {}
local bufferSize = 0

-- Detect key press/release
mouse.KeyDown:Connect(function(key)
    if key == ATTACK_KEY then
        isHoldingKey = true
    end
end)

mouse.KeyUp:Connect(function(key)
    if key == ATTACK_KEY then
        isHoldingKey = false
    end
end)

-- OPTIMIZED EXECUTION LOOP
local executionCounter = 0
RunService.Heartbeat:Connect(function()
    if not isHoldingKey or not AttackRemote then return end
    
    executionCounter = executionCounter + 1
    local currentTime = os.clock()
    local pingOffset = calculateAdvancedPing()
    
    -- IMPROVED COOLDOWN CALCULATION (3x better nocooldown)
    local adjustedCooldown = (BASE_COOLDOWN / 3) - (pingOffset * 0.9)
    
    -- Safety floor
    if adjustedCooldown < 0.008 then 
        adjustedCooldown = 0.008
    end
    
    -- BUFFERING SYSTEM for micro-delays
    if currentTime - lastAttackTime >= adjustedCooldown then
        table.insert(attackBuffer, {time = currentTime, ping = pingOffset})
        
        if #attackBuffer > THREAD_COUNT then
            table.remove(attackBuffer, 1)
        end
        
        -- MULTI-THREADED EXECUTION (9x performance boost)
        for i = 1, THREAD_COUNT do
            task.spawn(function()
                if AttackRemote:IsA("RemoteEvent") then
                    AttackRemote:FireServer()
                elseif AttackRemote:IsA("RemoteFunction") then
                    pcall(function()
                        AttackRemote:InvokeServer()
                    end)
                end
            end)
        end
        
        lastAttackTime = currentTime
    end
end)

print("[BOASTER 1 OPTIMIZED]: 9x Performance | 3x Nocooldown | 2x Ping Compensation Active")
