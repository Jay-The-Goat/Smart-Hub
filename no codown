local RunService = game:GetService("RunService")
local fastWait = function() 
    return RunService.PostSimulation:Wait() 
end
local instantSpawn = function(func, alternateFunc) 
    task.spawn(type(func) == "function" and func or alternateFunc) 
end
local targets = {
    [task.wait] = fastWait, 
    [wait] = fastWait, 
    [spawn] = instantSpawn, 
    [delay] = instantSpawn
}
for target, replacement in pairs(targets) do
    pcall(function()
        hookfunction(target, replacement)
    end)
end
task.spawn(function()
    local player = game.Players.LocalPlayer or game.Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
    local function listenToCharacter(char)
        char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                child:SetAttribute("Cooldown", 0)
                local cdObj = child:FindFirstChild("Cooldown")
                if cdObj and cdObj:IsA("ValueBase") then 
                    cdObj.Value = 0 
                end
            end
        end)
    end
    if player.Character then listenToCharacter(player.Character) end
    player.CharacterAdded:Connect(listenToCharacter)
end)
print("!Jay No Cooldown Running")