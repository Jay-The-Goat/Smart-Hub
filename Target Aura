local function CreateUserRow(player)
	local RowBtn = Instance.new("TextButton")
	RowBtn.Size = UDim2.new(1, -4, 0, 32)
	RowBtn.Text = "  " .. player.Name
	RowBtn.Font = Enum.Font.GothamMedium
	RowBtn.TextSize = 12
	RowBtn.TextXAlignment = Enum.TextXAlignment.Left
	RowBtn.AutoButtonColor = false

	local RowCorner = Instance.new("UICorner", RowBtn)
	RowCorner.CornerRadius = UDim.new(0, 5)

	local RowStroke = Instance.new("UIStroke", RowBtn)
	RowStroke.Thickness = 1

	local Indicator = Instance.new("Frame", RowBtn)
	Indicator.Size = UDim2.fromOffset(4, 14)
	Indicator.Position = UDim2.new(1, -12, 0.5, -7)
	Instance.new("UICorner", Indicator).CornerRadius = UDim.new(1, 0)

	-- Check structural persistence lookup maps to preserve dynamic UI selection states
	if getgenv().configs.TargetMap[player.Name] then
		RowBtn.BackgroundColor3 = Color3.fromRGB(38, 14, 14)
		RowBtn.TextColor3 = Color3.fromRGB(255, 200, 200)
		RowStroke.Color = Color3.fromRGB(240, 45, 45)
		RowStroke.Transparency = 0.3
		Indicator.BackgroundColor3 = Color3.fromRGB(255, 45, 45)
	else
		RowBtn.BackgroundColor3 = Color3.fromRGB(18, 10, 10)
		RowBtn.TextColor3 = Color3.fromRGB(200, 180, 180)
		RowStroke.Color = Color3.fromRGB(240, 45, 45)
		RowStroke.Transparency = 0.7
		Indicator.BackgroundColor3 = Color3.fromRGB(40, 20, 20)
	end

	-- Interaction Logic mapping dynamically back into the original TargetList array structure
	RowBtn.MouseButton1Click:Connect(function()
		local list = getgenv().configs.TargetList
		local idx = table.find(list, player)

		if idx then
			table.remove(list, idx)
			getgenv().configs.TargetMap[player.Name] = nil
			TweenService:Create(RowBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(18, 10, 10)}):Play()
			TweenService:Create(RowStroke, TweenInfo.new(0.15), {Transparency = 0.7}):Play()
			TweenService:Create(Indicator, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(40, 20, 20)}):Play()
		else
			table.insert(list, player)
			getgenv().configs.TargetMap[player.Name] = player
			TweenService:Create(RowBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(38, 14, 14)}):Play()
			TweenService:Create(RowStroke, TweenInfo.new(0.15), {Transparency = 0.3}):Play()
			TweenService:Create(Indicator, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 45, 45)}):Play()
		end
	end)

	return RowBtn
end

local function RerenderPlayerPool()
	for _, child in ipairs(ScrollFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= lp then
			CreateUserRow(player).Parent = ScrollFrame
		end
	end
end

-- UI Toggle Configuration
MenuHeaderBtn.MouseButton1Click:Connect(function()
	local isOpen = ScrollFrame.Visible
	if not isOpen then
		RerenderPlayerPool()
		ScrollFrame.Visible = true
		TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(220, 318)}):Play()
	else
		TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.fromOffset(220, 42)}):Play()
		task.delay(0.2, function() ScrollFrame.Visible = false end)
	end
end)

Players.PlayerAdded:Connect(RerenderPlayerPool)
Players.PlayerRemoving:Connect(function(player)
	local idx = table.find(getgenv().configs.TargetList, player)
	if idx then table.remove(getgenv().configs.TargetList, idx) end
	getgenv().configs.TargetMap[player.Name] = nil
	RerenderPlayerPool()
end)

-- =========================================================================
-- ⚡ TARGET AURA CORE (ORIGINAL LOOP LOGIC EXPORT)
-- =========================================================================

local lastFire = 0
local FIRE_RATE = 1/35 -- stable sweet spot

local function getTargets()
	local t = {}
	for _, plr in ipairs(getgenv().configs.TargetList) do
		local char = plr.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local hum = char:FindFirstChild("Humanoid")
			if hum and hum.Health > 0 then
				table.insert(t, char)
			end
		end
	end
	return t
end

local PRIORITY_PARTS = {
	"HumanoidRootPart",
	"Head",
	"UpperTorso",
	"LowerTorso"
}

local function hitTarget(tool, touch, char)
	for i = 1, #PRIORITY_PARTS do
		local part = char:FindFirstChild(PRIORITY_PARTS[i])
		if part and part:IsA("BasePart") then
			firetouchinterest(touch, part, 0)
			firetouchinterest(touch, part, 1)
		end
	end
end

table.insert(getgenv().configs.connections, RunService.PreSimulation:Connect(function()
	if not Run then return end
	if #getgenv().configs.TargetList == 0 then return end

	local now = os.clock()
	if now - lastFire < FIRE_RATE then return end
	lastFire = now

	local char = getchar()
	if not char then return end

	local targets = getTargets()
	if #targets == 0 then return end

	-- Original yield behavior
	RunService.PostSimulation:Wait()

	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then
			local touch = GetTouchInterest(tool)
			if not touch then continue end

			for _, targetChar in ipairs(targets) do hitTarget(tool, touch, targetChar)
end
end
end
end))


