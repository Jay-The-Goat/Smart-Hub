local function trackRetaliation(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then return end
	
	humanoid.Died:Connect(function()
		local creatorTag = character:FindFirstChild("creator") or humanoid:FindFirstChild("creator")
		local killerPlayer = nil
		
		if creatorTag and creatorTag:IsA("ObjectValue") and creatorTag.Value and creatorTag.Value:IsA("Player") then
			killerPlayer = creatorTag.Value
		else
			local myHRP = character:FindFirstChild("HumanoidRootPart")
			if myHRP then
				local closestDist = 25 
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
						local tool = p.Character:FindFirstChildWhichIsA("Tool")
						if tool then
							local dist = (p.Character.HumanoidRootPart.Position - myHRP.Position).Magnitude
							if dist < closestDist then
								closestDist = dist
								killerPlayer = p
							end
						end
					end
				end
			end
		end
		
		if killerPlayer and killerPlayer ~= lp then
			local list = getgenv().configs.TargetList
			if not table.find(list, killerPlayer) then
				table.insert(list, killerPlayer)
				getgenv().configs.TargetMap[killerPlayer.Name] = killerPlayer
				print("Retaliation Active: Locked onto killer -> " .. killerPlayer.Name)
				
				pcall(function()
					RerenderPlayerPool()
				end)
			end
		end
	end)
end

lp.CharacterAdded:Connect(trackRetaliation)
if lp.Character then task.spawn(trackRetaliation, lp.Character) end

