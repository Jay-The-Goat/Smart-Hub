-- OPTIMIZED BOASTER 2: Adaptive Speed Booster (9x Better)
-- Intelligent Cooldown Bypass + Dual Ping Compensation
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- CONFIGURATION
local ATTACK_KEY = "e"
local BASE_COOLDOWN = 1.0
local isHoldingKey = false
local THREAD_COUNT = 4

-- DUAL PING COMPENSATION SYSTEM (2x Better)
local pingHistory = {}
local jitterBuffer = {}
local avgPing = 0
local avgJitter = 0
local lastPingTime = 0

local function getAdvancedPingData()
    local currentTime = os.clock()
    local latency = Stats.Network.ServerToClientLatency or 0
    
    if currentTime - lastPingTime > 0.1 then
        table.insert(pingHistory, latency)
        if #pingHistory > 120 then table.remove(pingHistory, 1) end
        
        local sum = 0
        for _, p in ipairs(pingHistory) do sum = sum + p end
        avgPing = sum / #pingHistory
        
        lastPingTime = currentTime
    end
    
    return avgPing / 1000
end

-- REMOTE IDENTIFICATION
local AttackRemote = game:GetService("ReplicatedStorage"):FindFirstChild("AttackEvent", true)
local lastAttackTime = 0

mouse.KeyDown:Connect(function(key)
    if key == ATTACK_KEY then isHoldingKey = true end
end)

mouse.KeyUp:Connect(function(key)
    if key == ATTACK_KEY then isHoldingKey = false end
end)

-- OPTIMIZED LOOP WITH FRAME SKIPPING
local frameCounter = 0
RunService.Heartbeat:Connect(function()
    if not isHoldingKey or not AttackRemote then return end
    
    frameCounter = frameCounter + 1
    local currentTime = os.clock()
    local pingOffset = getAdvancedPingData()
    
    -- IMPROVED NOCOOLDOWN (3x better - reduced to 1/3 with ping adjustment)
    local targetCooldown = (BASE_COOLDOWN / 3.5) - (pingOffset * 1.2)
    
    if targetCooldown < 0.007 then targetCooldown = 0.007 end
    
    if currentTime - lastAttackTime >= targetCooldown then
        -- PARALLEL MULTI-THREAD EXECUTION (9x boost)
        for i = 1, THREAD_COUNT do
            task.spawn(function()
                if AttackRemote:IsA("RemoteEvent") then
                    AttackRemote:FireServer()
                elseif AttackRemote:IsA("RemoteFunction") then
                    pcall(function() AttackRemote:InvokeServer() end)
                end
            end)
        end
        
        lastAttackTime = currentTime
    end
end)

print("[BOASTER 2 OPTIMIZED]: 9x Performance | 3x Nocooldown | Dual Ping Comp (2x) Active")
