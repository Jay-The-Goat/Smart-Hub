local RunService = game:GetService("RunService")
local heartbeat = RunService.Heartbeat
local nativeWait = heartbeat.Wait

-- Tracks loop iterations to prevent Delta from locking up
local loopCounter = 0

local function freezeProofBypass()
    loopCounter = loopCounter + 1
    
    -- Runs 200 iterations instantly. On the 201st, it yields for exactly one engine tick.
    if loopCounter >= 200 then
        loopCounter = 0
        nativeWait(heartbeat) -- Micro-yield to prevent application freeze
    end
    
    return 0
end

-- Hook legacy frame cycle securely
if hookfunction and wait then
    hookfunction(wait, freezeProofBypass)
end

-- Hook modern framework task queue securely
if hookfunction and task and task.wait then
    hookfunction(task.wait, freezeProofBypass)
end
