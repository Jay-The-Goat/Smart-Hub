--[[
  LIGHTWEIGHT NO COOLDOWN - Zero Overhead
  - Only hooks cooldown functions
  - No loops, no welds, no extra processing
  - Won't lag your other scripts
]]

local RunService = game:GetService("RunService")

-- PURE COOLDOWN BYPASS - Nothing else
hookfunction(wait, function(duration)
	if not duration or duration < 1 then
		coroutine.yield()
	end
	return
end)

hookfunction(task.wait, function(duration)
	if not duration or duration < 1 then
		coroutine.yield()
	end
	return
end)

hookfunction(delay, function(duration, func)
	if func then task.spawn(func) end
end)

hookfunction(spawn, function(func)
	if func then task.spawn(func) end
end)

print("✅ Lightweight No Cooldown - Zero Lag")
