export default {
  async fetch(request, env) {
    const cors = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "POST, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type"
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: cors });
    }

    if (request.method !== "POST") {
      return new Response("Delta AI is online!", { headers: cors });
    }

    try {
      const { message } = await request.json();

      if (!message || typeof message !== "string") {
        return Response.json(
          { error: "Enter a message first." },
          { status: 400, headers: cors }
        );
      }

      if (!env.GROQ_API_KEY) {
        return Response.json(
          { error: "Groq API key is missing." },
          { status: 500, headers: cors }
        );
      }

      const response = await fetch(
        "https://api.groq.com/openai/v1/chat/completions",
        {
          method: "POST",
          headers: {
            "Authorization": `Bearer ${env.GROQ_API_KEY}`,
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            model: "llama-3.3-70b-versatile",
            messages: [
              {
                role: "system",
                content: "You are Delta AI, a helpful Roblox assistant. Help with Roblox updates, Lua scripting for Roblox Studio, and game development. Never claim to execute scripts inside Roblox."
              },
              {
                role: "user",
                content: message
              }
            ],
            temperature: 0.7,
            max_tokens: 1000
          })
        }
      );

      const data = await response.json();

      if (!response.ok) {
        return Response.json(
          { error: data.error?.message || "Groq request failed." },
          { status: response.status, headers: cors }
        );
      }

      return Response.json(
        {
          reply: data.choices?.[0]?.message?.content || "No response generated."
        },
        { headers: cors }
      );

    } catch (error) {
      return Response.json(
        { error: "Something went wrong. Try again." },
        { status: 500, headers: cors }
      );
    }
  }
};