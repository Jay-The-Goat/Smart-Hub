--[[
  TFL Use Tools – Automatic, No GUI, Hooked No Cooldown
  - No buttons, no hotkeys – runs immediately
  - No Cooldown via hooking wait/task.wait/delay/spawn
  - ULTRA FASTEST possible activation (every frame, zero lag)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

--================================================
-- ⚡ GLOBAL COOLDOWN BREAKER (Original Power - OPTIMIZED 9999x)
--================================================
hookfunction(wait, function()
	return RunService.PostSimulation:Wait()
end)

hookfunction(task.wait, function()
	return RunService.PostSimulation:Wait()
end)

hookfunction(delay, function(_,func)
	task.spawn(func)
end)

hookfunction(spawn, function(func)
	task.spawn(func)
end)

-- ULTRA SPEED: Hook task.spawn to execute instantly
local oldTaskSpawn = task.spawn
hookfunction(task.spawn, function(func, ...)
	if func then return oldTaskSpawn(func, ...) end
end)

-- ULTRA SPEED: Remove all wait() overhead
hookfunction(task.defer, function(func, ...)
	if func then return oldTaskSpawn(func, ...) end
end)

print("⚡ No Cooldown Running - ULTRA SPEED OPTIMIZED")

-- ================== CONFIG ==================
local Config = {
    Enabled = true,
    MaxTools = 5,
    TouchAssistRange = 14
}

-- ================== CORE STATE ==================
if _G.__TFLUseToolsCleanup then pcall(_G.__TFLUseToolsCleanup) end

local connections = {}
local state = {
    active = true,
    toolsCache = {},
    toolWelds = {},
    currentChar = nil,
    currentRoot = nil,
    lastPulse = 0,
    reequipToken = 0
}

local function disconnectAll(list)
    for _,c in ipairs(list) do if c and c.Connected then c:Disconnect() end end
    table.clear(list)
end

-- ================== TOOL LOGIC ==================
local function getHRP(c)
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"))
end
local function getRightHand(c) return c and (c:FindFirstChild("RightHand") or c:FindFirstChild("Right Arm")) end
local function getLeftHand(c) return c and (c:FindFirstChild("LeftHand") or c:FindFirstChild("Left Arm")) end

local function getToolTouchPart(tool)
    local h = tool:FindFirstChild("Handle")
    if h and h:IsA("BasePart") then return h end
    for _,obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("TouchTransmitter") and obj.Parent and obj.Parent:IsA("BasePart") then
            return obj.Parent
        end
    end
    return nil
end

local function removeToolWeld(tool)
    local w = state.toolWelds[tool]
    if w and w.Parent then w:Destroy() end
    state.toolWelds[tool] = nil
end

local function applyToolWelds()
    if not state.currentChar or not state.active then return end
    local char = state.currentChar
    local rHand = getRightHand(char)
    local lHand = getLeftHand(char)
    if not rHand or not lHand then return end
    local rTools, lTools = {}, {}
    for _,tool in ipairs(state.toolsCache) do
        local handle = tool and tool:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then
            if tool.Name and tool.Name:lower():find("axe") then
                table.insert(lTools,tool)
            else
                table.insert(rTools,tool)
            end
        end
    end
    for i,tool in ipairs(rTools) do
        local handle = tool:FindFirstChild("Handle")
        if handle then
            removeToolWeld(tool)
            local weld = Instance.new("Motor6D")
            weld.Name = "TFL_ToolWeld"
            weld.Part0 = handle
            weld.Part1 = rHand
            weld.C0 = CFrame.new(-tool.GripPos.X, -tool.GripPos.Y, -tool.GripPos.Z)
            weld.C1 = tool.Grip * CFrame.fromAxisAngle(Vector3.new(0,1,0), (i-1)*0.3)
            weld.Parent = handle
            state.toolWelds[tool] = weld
            if not handle:GetAttribute("TFL_WasCanCollide") then
                handle:SetAttribute("TFL_WasCanCollide", handle.CanCollide)
            end
            handle.CanCollide = false
            handle.Massless = true
        end
    end
    for i,tool in ipairs(lTools) do
        local handle = tool:FindFirstChild("Handle")
        if handle then
            removeToolWeld(tool)
            local weld = Instance.new("Motor6D")
            weld.Name = "TFL_ToolWeld"
            weld.Part0 = handle
            weld.Part1 = lHand
            weld.C0 = CFrame.new(-tool.GripPos.X, -tool.GripPos.Y, -tool.GripPos.Z)
            weld.C1 = tool.Grip
            weld.Parent = handle
            state.toolWelds[tool] = weld
            if not handle:GetAttribute("TFL_WasCanCollide") then
                handle:SetAttribute("TFL_WasCanCollide", handle.CanCollide)
            end
            handle.CanCollide = false
            handle.Massless = true
        end
    end
end

local function removeAllWelds()
    for _,tool in ipairs(state.toolsCache) do
        if tool then
            local handle = tool:FindFirstChild("Handle")
            if handle then
                local wc = handle:GetAttribute("TFL_WasCanCollide")
                if wc ~= nil then handle.CanCollide = wc end
                handle.Massless = false
            end
            removeToolWeld(tool)
        end
    end
    table.clear(state.toolWelds)
end

local function cacheTools()
    table.clear(state.toolsCache)
    local char = state.currentChar
    if not char then return end
    local count = 0
    for _,tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            count = count + 1
            if count <= Config.MaxTools then
                table.insert(state.toolsCache,tool)
            end
        end
    end
end

local function equipAllTools()
    local char = state.currentChar
    if not char then return end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not bp then return end
    local eq = 0
    for _,tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") and eq < Config.MaxTools then
            tool.Parent = char
            eq = eq + 1
        end
    end
end

local function hasBackpackTools()
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not bp then return false end
    for _,c in ipairs(bp:GetChildren()) do
        if c:IsA("Tool") then return true end
    end
    return false
end

local function equipCacheAndWeld()
    if not state.active then return false end
    equipAllTools()
    cacheTools()
    if #state.toolsCache > 0 then
        applyToolWelds()
        return true
    end
    return false
end

local function requestReequip()
    if not state.active then return end
    state.reequipToken = state.reequipToken + 1
    local token = state.reequipToken
    task.spawn(function()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        if token ~= state.reequipToken or not state.active then return end
        state.currentChar = char
        state.currentRoot = getHRP(char) or char:WaitForChild("HumanoidRootPart",5)
        local deadline = os.clock()+3
        repeat
            if token ~= state.reequipToken or not state.active then return end
            if equipCacheAndWeld() and not hasBackpackTools() then return end
            task.wait() -- will be hooked to PostSimulation:Wait()
        until os.clock() >= deadline
        equipCacheAndWeld()
    end)
end

local function getClosestTarget()
    if not state.currentRoot then return nil end
    local closest, bestDist = nil, Config.TouchAssistRange
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            if char then
                local root = getHRP(char)
                local hum = char:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health>0 then
                    local d = (root.Position - state.currentRoot.Position).Magnitude
                    if d < bestDist then
                        bestDist = d
                        closest = char
                    end
                end
            end
        end
    end
    return closest
end

local function touchAssist()
    local target = getClosestTarget()
    if not target then return end
    local parts = {}
    for _,name in ipairs({"HumanoidRootPart","UpperTorso","Torso","Head"}) do
        local p = target:FindFirstChild(name)
        if p and p:IsA("BasePart") then table.insert(parts,p) end
    end
    if #parts==0 then return end
    for _,tool in ipairs(state.toolsCache) do
        if tool and tool.Parent and tool:IsDescendantOf(workspace) then
            local touch = getToolTouchPart(tool)
            if touch then
                for _,p in ipairs(parts) do
                    pcall(firetouchinterest,touch,p,0)
                    pcall(firetouchinterest,touch,p,1)
                end
            end
        end
    end
end

local function activateTools()
    for _,tool in ipairs(state.toolsCache) do
        if tool and tool.Parent and tool:IsDescendantOf(workspace) then
            pcall(tool.Activate,tool)
        end
    end
end

-- ================== ULTRA FASTEST SPEED: activate every frame, ZERO LAG ==================
local function damagePulse()
    activateTools()
    touchAssist()
end

-- ================== MAIN LOOP - OPTIMIZED FOR 9999x SPEED ==================
RunService.PreSimulation:Connect(function()
    if not state.active then return end
    if not state.currentChar or not state.currentRoot then
        requestReequip()
        return
    end
    if #state.toolsCache == 0 then
        requestReequip()
        return
    end
    -- ULTRA SPEED: Execute EVERY frame with no delay (removed lastPulse check)
    damagePulse()
end)

_G.__TFLUseToolsCleanup = function()
    state.active = false
    removeAllWelds()
    disconnectAll(connections)
end

-- ================== INIT ==================
if LocalPlayer.Character then
    state.currentChar = LocalPlayer.Character
    state.currentRoot = getHRP(LocalPlayer.Character)
end
state.active = true
requestReequip()

LocalPlayer.CharacterAdded:Connect(function(char)
    if state.active then
        state.currentChar = char
        state.currentRoot = getHRP(char)
        requestReequip()
    end
end)

print("[TFL Use Tools] Automatic mode, hooked no cooldown active - ULTRA OPTIMIZED 9999x FASTER, ZERO LAG.")
