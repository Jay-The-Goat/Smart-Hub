--!strict
-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Environment & State
local LocalPlayer = Players.LocalPlayer
assert(LocalPlayer, "LocalPlayer not initialized")

local CONFIG = {
    Enabled = true,
    MaxTools = 20,
    TouchAssistRange = 14,
    ActivationBudgetPerFrame = 5, -- Throttles activations to prevent packet drops and client stalls
}

-- References Cache
local currentCharacter: Model? = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local currentHumanoidRootPart: BasePart? = nil

-- Update local character state to avoid repeated indexing overhead
local function updateCharacterReferences(char: Model)
    currentCharacter = char
    currentHumanoidRootPart = char:WaitForChild("HumanoidRootPart", 5) :: BasePart?
end

LocalPlayer.CharacterAdded:Connect(updateCharacterReferences)
if currentCharacter then
    updateCharacterReferences(currentCharacter)
end

-- Fast Tool Aggregator
local function getUsableTools(): {Tool}
    local tools = table.create(CONFIG.MaxTools)
    local count = 0

    -- Check character tools (equipped)
    if currentCharacter then
        for _, child in ipairs(currentCharacter:GetChildren()) do
            if child:IsA("Tool") then
                count += 1
                tools[count] = child
                if count >= CONFIG.MaxTools then
                    return tools
                end
            end
        end
    end

    -- Check backpack tools (unequipped)
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") then
                count += 1
                tools[count] = child
                if count >= CONFIG.MaxTools then
                    return tools
                end
            end
        end
    end

    return tools
end

-- Core Execution Cycle
-- Utilizing PreSimulation avoids post-render micro-stutters and aligns actions with physics steps
local running = false
local function processToolBatch()
    if running or not CONFIG.Enabled then return end
    running = true

    local tools = getUsableTools()
    local operationsThisFrame = 0

    for i = 1, #tools do
        local tool = tools[i]
        if not tool or not tool.Parent then continue end

        -- Fast non-blocking invocation
        task.spawn(function()
            if tool:IsA("Tool") and tool:FindFirstChild("Activate") then
                tool:Activate()
            else
                -- Fallback directly calling tool activation without global timer manipulation
                pcall(tool.Activate, tool)
            end
        end)

        operationsThisFrame += 1
        if operationsThisFrame >= CONFIG.ActivationBudgetPerFrame then
            -- Yield to prevent network buffer overflow and maintain solid 60 FPS
            RunService.PreSimulation:Wait()
            operationsThisFrame = 0
        end
    end

    running = false
end

-- Connection Handler
local simulationConnection: RBXScriptConnection?
simulationConnection = RunService.PreSimulation:Connect(function()
    if CONFIG.Enabled then
        processToolBatch()
    end
end)
