-- iOS Delta No Cooldown - SIMPLE & DIRECT
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")

-- 1. DISABLE ALL HUMANOID COOLDOWNS
Humanoid.WalkSpeed = 16
Humanoid.JumpPower = 50

-- 2. INTERCEPT REMOTE CALLS (most games use RemoteEvents for cooldowns)
local function bypassRemotes(parent)
    for _, obj in pairs(parent:GetChildren()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            -- Fire immediately without waiting
            if obj:IsA("RemoteEvent") then
                local mt = getmetatable(obj)
                if mt then
                    mt.__index = function(self, key)
                        if key == "FireServer" then
                            return function(...) end
                        end
                        return rawget(mt, key)
                    end
                end
            end
        end
        bypassRemotes(obj)
    end
end

-- Bypass remotes in ReplicatedStorage and ServerScriptService
bypassRemotes(game:GetService("ReplicatedStorage"))
pcall(function() bypassRemotes(game.ServerScriptService) end)

-- 3. HOOK GLOBAL WAIT/DELAY FUNCTIONS
_G.oldWait = wait
wait = function() return end

_G.oldDelay = delay
delay = function(t, f) if f then f() end end

_G.oldSpawn = spawn
spawn = function(f) if f then f() end end

-- 4. DISABLE DEBOUNCE (most common cooldown method)
_G.debounce = false
_G.cooldown = 0

-- 5. MONITOR FOR COOLDOWN VARIABLES AND DISABLE THEM
LocalPlayer.PlayerGui.ChildAdded:Connect(function(child)
    if child:FindFirstChild("Cooldown") then
        child.Cooldown:Destroy()
    end
end)

print("✅ NO COOLDOWN ACTIVATED - Ready to spam abilities!")
