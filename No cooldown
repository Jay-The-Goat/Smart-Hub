export default {
  async fetch(request, env) {
    const cors = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "POST, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type"
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: cors });
    }

    if (request.method !== "POST") {
      return new Response("Delta AI is online!", {
        headers: cors
      });
    }

    try {
      const body = await request.json();
      const message = body.message;

      if (!message || typeof message !== "string") {
        return Response.json(
          { error: "Please enter a message." },
          { status: 400, headers: cors }
        );
      }

      if (!env.GROQ_API_KEY) {
        return Response.json(
          { error: "Groq API key is missing. Check Cloudflare Secrets." },
          { status: 500, headers: cors }
        );
      }

      const response = await fetch(
        "https://api.groq.com/openai/v1/chat/completions",
        {
          method: "POST",
          headers: {
            "Authorization": `Bearer ${env.GROQ_API_KEY}`,
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            model: "openai/gpt-oss-120b",
            messages: [
              {
                role: "system",
                content: `You are Delta AI, an advanced Roblox assistant.

Your responsibilities:
- Help users understand Roblox updates.
- Help with Roblox Lua scripting.
- Help with Roblox Studio development.
- Explain game mechanics.
- Help troubleshoot Roblox issues.
- Provide compatibility information based on available public information.
- Be friendly, intelligent, and detailed.

Never claim to execute scripts inside Roblox.
Never claim to bypass Roblox anti-cheat.`
              },
              {
                role: "user",
                content: message
              }
            ],
            temperature: 0.7,
            max_tokens: 1200
          })
        }
      );

      const data = await response.json();

      if (!response.ok) {
        return Response.json(
          {
            error: data.error?.message || "Groq AI request failed."
          },
          {
            status: response.status,
            headers: cors
          }
        );
      }

      const answer =
        data.choices?.[0]?.message?.content ||
        "Delta AI couldn't generate a response.";

      return Response.json(
        { reply: answer },
        { headers: cors }
      );

    } catch (error) {
      return Response.json(
        { error: "Delta AI encountered an unexpected error." },
        {
          status: 500,
          headers: cors
        }
      );
    }
  }
};