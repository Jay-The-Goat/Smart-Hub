-- UC No Cooldown (ULTRA OPTIMIZED - Zero Lag Edition)
if not hookfunction or typeof(hookfunction) ~= "function" then 
    return print("❌ Executor does not support hookfunction") 
end

local debug_info = debug.info
local game = game
local workspace = game:GetService("Workspace")

-- Pre-cache blocked classes for instant lookup
local blocked_classes = {
    ParticleEmitter = true, Trail = true, Explosion = true,
    Sound = true, Smoke = true, Sparkles = true, Fire = true,
    Beam = true, PointLight = true, SurfaceGui = true, BillboardGui = true
}

-- Pre-cache debris folders
local debris_folders = {"Debris", "Effects", "Projectiles", "Particles"}

-- 1. ULTRA-FAST LAG PURGE: Instant object interception
local oldNewInstance = Instance.new
Instance.new = function(className, parent)
    if blocked_classes[className] then
        return oldNewInstance("Folder") -- Return immediately, no destroy overhead
    end
    return oldNewInstance(className, parent)
end
hookfunction(Instance.new, Instance.new)

-- Clear debris instantly on load (single pass)
for _, folder_name in ipairs(debris_folders) do
    local folder = workspace:FindFirstChild(folder_name)
    if folder then folder:ClearAllChildren() end
end

-- 2. ZERO-WAIT SPEED: Aggressive wait/delay interception
local dummy_coroutine = coroutine.create(function() end)

local oldTaskWait = task.wait
task.wait = function(duration)
    if not duration or duration < 1 then
        return coroutine.yield()
    end
    return oldTaskWait(duration)
end
hookfunction(task.wait, task.wait)

local oldWait = wait
wait = function(duration)
    if not duration or duration < 1 then
        return coroutine.yield()
    end
    return oldWait(duration)
end
hookfunction(wait, wait)

-- Hook delay for instant execution
pcall(function()
    hookfunction(delay, function(_, func)
        task.spawn(func)
    end)
end)

-- Hook spawn for instant execution
pcall(function()
    hookfunction(spawn, function(func)
        task.spawn(func)
    end)
end)

-- 3. MEMORY OPTIMIZATION: Disable render stepping lag sources
pcall(function()
    game:GetService("RunService").RenderStepped:Connect(function()
        if workspace:FindFirstChild("Debris") then
            workspace.Debris:ClearAllChildren()
        end
    end)
end)

print("⚡ ULTRA NO-LAG ACTIVATED - 0ms Cooldown Engaged")
