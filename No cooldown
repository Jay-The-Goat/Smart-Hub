local RunService = game:GetService("RunService")
local heartbeat = RunService.Heartbeat
local nativeWait = heartbeat.Wait

-- Optimized counter variable
local iterations = 0

local function doubleSpeedBypass()
    iterations = iterations + 1
    
    -- DOUBLED SPEED: Runs 400 iterations completely instantly before a single frame tick
    if iterations % 400 == 0 then
        iterations = 0
        nativeWait(heartbeat) -- Micro-yield to keep Delta from freezing
    end
    
    return 0
end

-- Hook legacy frame cycle
if hookfunction and wait then
    hookfunction(wait, doubleSpeedBypass)
end

-- Hook modern framework task queue
if hookfunction and task and task.wait then
    hookfunction(task.wait, doubleSpeedBypass)
end
