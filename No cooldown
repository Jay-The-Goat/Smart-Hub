-- UC No Cooldown (Instant & Lag-Free Global Edition)
if not hookfunction or typeof(hookfunction) ~= "function" then 
    return print("❌ Executor does not support hookfunction") 
end

-- Hook task.wait globally
local oldTaskWait
oldTaskWait = hookfunction(task.wait, function(duration)
    -- If it's a short cooldown wait, bypass time entirely via instant micro-step resumption
    if not duration or duration <= 0.5 then
        task.defer(coroutine.running())
        return coroutine.yield()
    end
    return oldTaskWait(duration) -- Let structural long waits pass safely
end)

-- Hook legacy wait globally
local oldWait
oldWait = hookfunction(wait, function(duration)
    if not duration or duration <= 0.5 then
        task.defer(coroutine.running())
        return coroutine.yield()
    end
    return oldWait(duration)
end)

-- Hook legacy delay for instant fire
pcall(function()
    hookfunction(delay, function(_, func)
        task.spawn(func)
    end)
end)

-- Hook legacy spawn for instant fire
pcall(function()
    hookfunction(spawn, function(func)
        task.spawn(func)
    end)
end)

print("⚡ UC Pure No-Cooldown Running (Fast & Fluid)")
