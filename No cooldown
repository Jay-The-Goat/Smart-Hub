--[[
  LIGHTWEIGHT NO COOLDOWN WITH DAMAGE - Zero Lag
  - Cooldown bypass via hooks
  - Tool activation for damage
  - Minimal overhead
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- PURE COOLDOWN BYPASS
hookfunction(wait, function(duration)
	if not duration or duration < 1 then
		coroutine.yield()
	end
	return
end)

hookfunction(task.wait, function(duration)
	if not duration or duration < 1 then
		coroutine.yield()
	end
	return
end)

hookfunction(delay, function(duration, func)
	if func then task.spawn(func) end
end)

hookfunction(spawn, function(func)
	if func then task.spawn(func) end
end)

-- LIGHTWEIGHT DAMAGE ACTIVATION
local lastActivate = 0
RunService.PreSimulation:Connect(function()
	if not LocalPlayer.Character then return end
	
	local now = os.clock()
	if now - lastActivate < 0.001 then return end
	lastActivate = now
	
	-- Activate all tools in character
	for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
		if tool:IsA("Tool") then
			pcall(function() tool:Activate() end)
		end
	end
	
	-- Touch assist to closest player
	local char = LocalPlayer.Character
	local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
	if not root then return end
	
	local closest, bestDist = nil, 15
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local pChar = plr.Character
			if pChar then
				local pRoot = pChar:FindFirstChild("HumanoidRootPart") or pChar:FindFirstChild("Torso")
				if pRoot then
					local d = (pRoot.Position - root.Position).Magnitude
					if d < bestDist then
						bestDist = d
						closest = pChar
					end
				end
			end
		end
	end
	
	if closest then
		for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
			if tool:IsA("Tool") then
				local handle = tool:FindFirstChild("Handle")
				if handle then
					local targetParts = {closest:FindFirstChild("HumanoidRootPart"), closest:FindFirstChild("Torso"), closest:FindFirstChild("Head")}
					for _, p in ipairs(targetParts) do
						if p then
							pcall(firetouchinterest, handle, p, 0)
							pcall(firetouchinterest, handle, p, 1)
						end
					end
				end
			end
		end
	end
end)

print("✅ Lightweight No Cooldown with Damage - Zero Lag")
