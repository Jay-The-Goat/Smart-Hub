-- 1. REAL-TIME DATA TRACKERS & CONFIGURATION
-- ==========================================================
local selectedTargets = {} -- {[Player] = {RowObject = Instance, Connection = RBXScriptConnection}}
local myDeathCount = 0
local myConnections = {}

-- Fast tracking hook loop for local player deaths
local function hookLocalDeathSystem()
    for _, conn in ipairs(myConnections) do conn:Disconnect() end
    myConnections = {}

    local function onCharacter(char)
        local hum = char:WaitForChild("Humanoid", 10)
        if hum then
            table.insert(myConnections, hum.Died:Connect(function()
                myDeathCount = myDeathCount + 1
                if SecureUIFolder:FindFirstChild("KillCounterSystemRemake") then
                    SecureUIFolder.KillCounterSystemRemake.KillCounterFrame.MyDeathsValue.Text = tostring(myDeathCount)
                end
            end))
        end
    end

    table.insert(myConnections, localPlayer.CharacterAdded:Connect(onCharacter))
    if localPlayer.Character then onCharacter(localPlayer.Character) end
end

