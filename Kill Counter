-- 4. LIVE SUB-ROW DESIGN CREATOR & DESTRUCTION ENGINE
-- ==========================================================
local function addPlayerToLiveCounter(targetPlayer)
    if selectedTargets[targetPlayer] then return end

    local count = 0
    local connections = {}

    -- Create individual row tile layout parameters inside the counter box
    local TargetRow = Instance.new("Frame")
    TargetRow.Name = targetPlayer.Name .. "_Row"
    TargetRow.Size = UDim2.new(1, 0, 0, 24)
    TargetRow.BackgroundTransparency = 1
    TargetRow.Parent = ActiveTargetsScroller

    local NameLabel = Instance.new("TextLabel")
    NameLabel.Size = UDim2.new(0.7, 0, 1, 0)
    NameLabel.Text = targetPlayer.Name
    NameLabel.TextColor3 = Color3.fromRGB(240, 220, 215)
    NameLabel.TextSize = 13
    NameLabel.Font = Enum.Font.GothamBold
    NameLabel.TextXAlignment = Enum.TextXAlignment.Left
    NameLabel.BackgroundTransparency = 1
    NameLabel.Parent = TargetRow

    local ValueLabel = Instance.new("TextLabel")
    ValueLabel.Size = UDim2.new(0.3, 0, 1, 0)
    ValueLabel.Position = UDim2.new(0.7, -10, 0, 0)
    ValueLabel.Text = "0"
    ValueLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
    ValueLabel.TextSize = 16
    ValueLabel.Font = Enum.Font.GothamBold
    ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Parent = TargetRow

    -- Zero-Delay direct lifestyle tracking sequence
    local function hookCharacter(char)
        local hum = char:WaitForChild("Humanoid", 10)
        if hum then
            table.insert(connections, hum.Died:Connect(function()
                count = count + 1
                ValueLabel.Text = tostring(count)
            end))
end
end
table.insert(connections, targetPlayer.CharacterAdded:Connect(hookCharacter))
if targetPlayer.Character then hookCharacter(targetPlayer.Character) end
-- Store active memory arrays references
selectedTargets[targetPlayer] = {
RowObject = TargetRow,
Connections = connections,
ResetCounter = function() count = 0 ValueLabel.Text = "0" end
}
-- Recalculate Scroll Panel Layout Size Bounds
local activeRows = 0
for _ in pairs(selectedTargets) do activeRows = activeRows + 1 end
ActiveTargetsScroller.CanvasSize = UDim2.new(0, 0, 0, activeRows * 28)
end
local function removePlayerFromLiveCounter(targetPlayer)
local targetData = selectedTargets[targetPlayer]
if not targetData then return end
-- Tear down execution logs threads safely
for _, conn in ipairs(targetData.Connections) do conn:Disconnect() end
if targetData.RowObject then targetData.RowObject:Destroy() end
selectedTargets[targetPlayer] = nil
local activeRows = 0
for _ in pairs(selectedTargets) do activeRows = activeRows + 1 end
ActiveTargetsScroller.CanvasSize = UDim2.new(0, 0, 0, activeRows * 28)
end
-- Reset button listener clears internal counts
ResetBtn.MouseButton1Click:Connect(function()
for _, targetData in pairs(selectedTargets) do
targetData.ResetCounter()
end
end)
