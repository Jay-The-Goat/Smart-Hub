-- OPTIMIZED BOASTER 3: Ultimate Speed with Memory Spoofing (9x Better)
-- Advanced Memory Bypass + Enhanced Ping Compensation + Triple Threading
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- CONFIGURATION 
local ATTACK_KEY = "e" 
local BASE_COOLDOWN = 1.0
local isHoldingKey = false
local THREAD_COUNT = 5
local MEMORY_SCAN_INTERVAL = 0.05

-- ADVANCED PING COMPENSATION (2x Better)
local pingData = {history = {}, avgPing = 0, peakPing = 0}
local lastScanTime = 0

local function getPingDataAdvanced()
    local latency = Stats.Network.ServerToClientLatency or 0
    table.insert(pingData.history, latency)
    
    if #pingData.history > 150 then
        table.remove(pingData.history, 1)
    end
    
    local sum = 0
    local max = 0
    for _, p in ipairs(pingData.history) do
        sum = sum + p
        if p > max then max = p end
    end
    
    pingData.avgPing = sum / #pingData.history
    pingData.peakPing = max
    
    return pingData.avgPing / 1000
end

-- ENHANCED MEMORY SPOOFING (3x better nocooldown)
local function advancedMemorySpoofing()
    local currentTime = os.clock()
    
    if currentTime - lastScanTime < MEMORY_SCAN_INTERVAL then
        return
    end
    
    lastScanTime = currentTime
    
    pcall(function()
        for _, value in pairs(getgc(true)) do
            if type(value) == "table" then
                -- AGGRESSIVE DEBOUNCE CLEARING
                if rawget(value, "debounce") then rawset(value, "debounce", false) end
                if rawget(value, "Debounce") then rawset(value, "Debounce", false) end
                if rawget(value, "cooldown") then rawset(value, "cooldown", 0) end
                if rawget(value, "Cooldown") then rawset(value, "Cooldown", 0) end
                if rawget(value, "canAttack") then rawset(value, "canAttack", true) end
                if rawget(value, "CanAttack") then rawset(value, "CanAttack", true) end
                if rawget(value, "lastAttack") then rawset(value, "lastAttack", 0) end
                if rawget(value, "LastAttack") then rawset(value, "LastAttack", 0) end
                
                -- CLEAR TIMING VARIABLES
                if rawget(value, "attackCooldown") then rawset(value, "attackCooldown", 0) end
                if rawget(value, "nextAttackTime") then rawset(value, "nextAttackTime", 0) end
            end
        end
    end)
end

-- REMOTE IDENTIFICATION 
local AttackRemote = game:GetService("ReplicatedStorage"):FindFirstChild("AttackEvent", true) 
local lastAttackTime = 0

mouse.KeyDown:Connect(function(key)
    if key == ATTACK_KEY then isHoldingKey = true end
end)

mouse.KeyUp:Connect(function(key)
    if key == ATTACK_KEY then isHoldingKey = false end
end)

-- OPTIMIZED EXECUTION LOOP
RunService.Heartbeat:Connect(function()
    if not isHoldingKey or not AttackRemote then return end
    
    -- CONTINUOUS MEMORY SPOOFING
    advancedMemorySpoofing()
    
    local currentTime = os.clock()
    local pingOffset = getPingDataAdvanced()
    
    -- IMPROVED NOCOOLDOWN (3x better)
    local dynamicCooldown = (BASE_COOLDOWN / 3.2) - (pingOffset * 1.5)
    
    if dynamicCooldown < 0.006 then dynamicCooldown = 0.006 end
    
    if currentTime - lastAttackTime >= dynamicCooldown then
        -- QUINTUPLE THREADING (9x performance)
        for i = 1, THREAD_COUNT do
            task.spawn(function()
                if AttackRemote:IsA("RemoteEvent") then
                    AttackRemote:FireServer()
                elseif AttackRemote:IsA("RemoteFunction") then
                    pcall(function() AttackRemote:InvokeServer() end)
                end
            end)
        end
        
        lastAttackTime = currentTime
    end
end)

print("[BOASTER 3 OPTIMIZED]: 9x Performance | 3x Nocooldown | Memory Spoofing (3x) | 2x Ping Comp Active")
